{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-amber-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 xl:flex-row xl:items-end">
    <div class="max-w-2xl"><span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-amber-300"></span>Verified calculation</span><h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Computation &amp; rankings</h1><p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Compute weighted contestant scores from complete judge sheets and the event's configured formula. Unresolved discrepancies or incomplete records block computation.</p></div>
  {{#if selected}}<div class="grid w-full gap-2 sm:grid-cols-2 xl:w-auto xl:min-w-[27rem]"><form method="GET" action="/tabulator/computation" class="flex items-center"><label class="sr-only" for="computationEvent">Select assigned event</label><select id="computationEvent" name="eventId" class="w-full rounded-xl border border-white/15 bg-white/[0.08] px-3.5 py-2.5 text-sm text-white outline-none transition focus:border-amber-300 focus:ring-4 focus:ring-amber-300/10" onchange="this.form.submit()">{{#each events}}<option class="text-slate-900" value="{{id}}" {{#if (eq ../selected.id id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></form><a href="/tabulator/reports?eventId={{selected.id}}" class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-400 px-4 py-2.5 text-sm font-bold text-slate-950 shadow-sm transition hover:bg-amber-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H5V3h2Zm7 0v5h5M8 13h8m-8 4h8"/></svg>Generate results report</a></div>{{/if}}
  </div>
</section>
{{#if selected}}
<section class="mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-100 bg-gradient-to-r from-blue-50/70 via-white to-amber-50/60 p-5 sm:p-6"><div class="flex items-start gap-3"><span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-800 ring-1 ring-blue-200"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 15 2 2 4-4"/></svg></span><div><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">Selected event</p><h2 class="mt-1 text-xl font-bold text-slate-950">{{selected.name}}</h2><p class="mt-1 text-sm text-slate-600">{{#if (eq selected.scoringFormula 'average_weighted')}}Average of weighted judge scores{{else}}Sum of weighted judge scores{{/if}} <span class="mx-1 text-slate-300">·</span> {{quality.judges}} assigned judges <span class="mx-1 text-slate-300">·</span> {{quality.contestantCount}} registered contestants</p></div></div><span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold capitalize text-slate-700"><span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>{{selected.status}}</span></div>
  <div class="grid grid-cols-2 gap-3 p-5 sm:grid-cols-3 lg:grid-cols-5 sm:p-6"><div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Valid submitted sheets</p><p class="mt-2 text-lg font-bold text-slate-900">{{quality.completeSheets}} <span class="text-sm font-medium text-slate-400">/ {{quality.expectedSheets}}</span></p></div><div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Contestants to resolve</p><p class="mt-2 text-lg font-bold {{#if quality.incompleteContestants}}text-amber-800{{else}}text-emerald-800{{/if}}">{{quality.incompleteContestants}}</p></div><div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Open discrepancies</p><p class="mt-2 text-lg font-bold {{#if quality.openIssues}}text-rose-800{{else}}text-emerald-800{{/if}}">{{quality.openIssues}}</p></div><div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Unassigned judge sheets</p><p class="mt-2 text-lg font-bold {{#if quality.unassignedSheets}}text-amber-800{{else}}text-emerald-800{{/if}}">{{quality.unassignedSheets}}</p></div><div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Current result rows</p><p class="mt-2 text-lg font-bold text-slate-900">{{quality.resultCount}}</p></div></div>
</section>
{{#if scoringOpen}}
<section class="mb-6 overflow-hidden rounded-2xl border {{#if quality.ready}}border-emerald-200 bg-gradient-to-r from-emerald-50 via-white to-teal-50{{else}}border-amber-200 bg-gradient-to-r from-amber-50 via-white to-orange-50{{/if}} p-5 shadow-sm sm:p-6">
  {{#if quality.ready}}
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center"><div class="flex items-start gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 ring-1 ring-emerald-200"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg></span><div><h2 class="font-bold text-emerald-950">Validation passed — ready to compute</h2><p class="mt-1 text-sm leading-6 text-emerald-900">Every registered contestant has complete, range-checked submissions from all assigned judges. No open discrepancies remain.</p></div></div><button type="button" onclick="openConfirmAction('computeModal','computeForm','/tabulator/computation/{{selected.id}}','{{jsonAttr selected.name}}','Compute rankings')" class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg>Compute &amp; verify</button></div>
  {{else}}
  <h2 class="font-semibold text-amber-950">Resolve validation items before computation</h2><p class="mt-1 text-sm leading-6 text-amber-900">Rankings cannot be computed until every required submission is complete and all discrepancies are resolved.</p>
  {{/if}}
</section>
{{else}}
<section class="mb-6 flex items-start gap-3 rounded-2xl border border-slate-200 bg-gradient-to-r from-slate-100 to-slate-50 p-5 shadow-sm"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-slate-200 text-slate-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 10V7a4 4 0 1 1 8 0v3"/></svg></span><div><h2 class="font-bold text-slate-800">{{#if (eq selected.status 'published')}}Results are published and locked{{else if (eq selected.status 'tabulated')}}Rankings are verified and locked{{else if (eq selected.status 'archived')}}Archived event — tabulation is locked{{else}}Computation is not available in this event phase{{/if}}</h2><p class="mt-1 text-sm leading-6 text-slate-600">Tabulation is limited to ongoing or judging events. Existing result records remain available below for authorized review.</p></div></section>
{{/if}}
<section class="mb-6 overflow-hidden rounded-2xl border border-amber-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-amber-100 bg-gradient-to-r from-amber-50 to-orange-50 px-5 py-4 sm:px-6">
    <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-800 ring-1 ring-amber-200"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg></span><div><h2 class="font-bold text-amber-950">Current score leaders</h2><p class="mt-1 text-xs text-amber-900">Official placements are based on verified rankings and the event's scoring formula.</p></div></div>
    {{#if results.length}}<span class="rounded-full border border-amber-200 bg-white px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-amber-900">Top scores</span>{{/if}}
  </div>
  {{#if leaders.length}}
  <div class="grid divide-y divide-slate-100 md:grid-cols-3 md:divide-x md:divide-y-0">
    {{#each leaders}}
    <article class="relative overflow-hidden p-5 transition hover:bg-slate-50/60 {{#if (eq rank 1)}}bg-amber-50/50{{/if}}">
      {{#if (eq rank 1)}}<div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-amber-400 to-orange-400"></div>{{/if}}
      <div class="flex items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-[0.14em] {{#if (eq rank 1)}}text-amber-800{{else}}text-slate-500{{/if}}">{{placementLabel}}</p><h3 class="mt-2 text-lg font-bold text-slate-950">{{contestantName}}</h3><p class="mt-1 text-xs text-slate-500">Contestant {{Contestant.contestantNumber}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl {{#if (eq rank 1)}}bg-amber-100 text-amber-800{{else}}bg-slate-100 text-slate-600{{/if}}"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg></span></div>
      <p class="mt-4 text-2xl font-bold tabular-nums text-slate-950">{{#if (eq ../selected.scoringFormula 'sum_weighted')}}{{totalWeightedScore}}{{else}}{{averageScore}}{{/if}}</p>
      <p class="mt-1 text-xs text-slate-500">{{#if (eq ../selected.scoringFormula 'sum_weighted')}}Weighted total{{else}}Average weighted score{{/if}} <span class="mx-1 text-slate-300">·</span> raw {{totalRawScore}}</p>
    </article>
    {{/each}}
  </div>
  {{else}}
  <div class="px-5 py-10 text-center"><span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg></span><p class="mt-3 font-semibold text-slate-800">No verified leaders yet</p><p class="mt-1 text-sm text-slate-500">Submit all required judge sheets and compute rankings to identify the champion and runner-ups.</p></div>
  {{/if}}
</section>
{{#if incomplete.length}}
<section class="mb-6 overflow-hidden rounded-2xl border border-amber-200 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-amber-100 bg-gradient-to-r from-amber-50 to-orange-50 px-5 py-4"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-800 ring-1 ring-amber-200"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" d="M12 9v4m0 3h.01"/></svg></span><div><h2 class="font-bold text-amber-950">Contestants with incomplete submissions</h2><p class="mt-1 text-xs text-amber-900">Each registered contestant requires one complete submitted score sheet from every assigned judge.</p></div></div>
  <div class="divide-y divide-slate-100">{{#each incomplete}}<div class="flex flex-wrap items-center justify-between gap-4 px-5 py-4 transition hover:bg-amber-50/30 sm:px-6"><div class="flex min-w-0 items-start gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-amber-50 text-xs font-semibold text-amber-700 ring-1 ring-amber-100">{{#if imageUrl}}<img src="{{imageUrl}}" alt="{{fullName}}" class="h-full w-full object-cover" loading="lazy" />{{else}}<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>{{/if}}</span><div class="min-w-0"><p class="font-semibold text-slate-800">{{fullName}}</p><p class="mt-1 text-xs text-slate-500">Contestant {{contestantNumber}}</p>{{#each reviewNotes}}<p class="mt-1 text-xs text-amber-800">{{this}}</p>{{/each}}</div></div><span class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-semibold text-amber-900"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>{{submitted}} / {{expected}} complete judge sheets</span></div>{{/each}}</div>
</section>
{{/if}}
<section class="mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"/></svg></span>
    <div><h2 class="font-bold text-slate-950">Judge score breakdown</h2>
    <p class="mt-1 text-xs leading-5 text-slate-500">Each row shows a judge's saved scores for a contestant. Draft and submitted scores are visible here; only submitted, complete sheets are included in official tabulation. Weighted criterion points are calculated using score ÷ maximum score × criterion weight.</p>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[1050px] text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Contestant</th><th class="px-5 py-4 font-bold">Judge</th><th class="px-5 py-4 font-bold">Criterion scores</th><th class="px-5 py-4 text-right font-bold">Raw total</th><th class="px-5 py-4 text-right font-bold">Weighted total</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each submittedScores}}
        <tr class="align-top transition hover:bg-violet-50/25">
          <td class="whitespace-nowrap px-5 py-4"><div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-[10px] font-bold text-blue-700 ring-1 ring-blue-100">{{contestantNumber}}</span><div><p class="font-semibold text-slate-900">{{contestantName}}</p><p class="mt-1 text-[10px] font-bold uppercase tracking-[0.1em] text-slate-400">Contestant</p></div></div></td>
          <td class="whitespace-nowrap px-5 py-4"><p class="font-medium text-slate-800">{{judgeName}}</p><span class="mt-1.5 inline-flex items-center gap-1.5 rounded-full border px-2 py-1 text-[10px] font-semibold uppercase tracking-wide {{#if (eq status 'submitted')}}border-blue-200 bg-blue-50 text-blue-800{{else}}border-amber-200 bg-amber-50 text-amber-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq status 'submitted')}}bg-blue-500{{else}}bg-amber-500{{/if}}"></span>{{status}}{{#if (eq status 'draft')}} · excluded from tabulation{{/if}}</span></td>
          <td class="min-w-80 px-5 py-4">
            {{#each scores}}<div class="flex flex-wrap justify-between gap-x-4 gap-y-1 border-b border-slate-100 py-2 first:border-0 first:pt-0 last:border-0 last:pb-0"><span class="font-medium text-slate-700">{{criterionName}} <span class="text-[10px] text-slate-500">({{weight}}%)</span></span><span class="whitespace-nowrap text-right tabular-nums text-slate-700">{{scoreValue}} / {{maxScore}} <span class="text-xs text-slate-400">→</span> <span class="font-semibold text-violet-800">{{weightedScore}}</span></span></div>{{else}}<span class="inline-flex items-center gap-1.5 text-xs text-amber-800"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>No criterion scores found.</span>{{/each}}
          </td>
          <td class="whitespace-nowrap px-5 py-4 text-right font-medium tabular-nums text-slate-700">{{rawTotal}}</td>
          <td class="whitespace-nowrap px-5 py-4 text-right"><span class="inline-flex min-w-20 justify-end rounded-lg bg-violet-50 px-2.5 py-1.5 font-bold tabular-nums text-violet-800">{{weightedTotal}}</span></td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-14 text-center" colspan="5"><span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"/></svg></span><p class="mt-3 font-semibold text-slate-700">No judge scores saved yet</p><p class="mt-1 text-sm text-slate-500">Draft and submitted scores will appear here as soon as judges save their sheets. Only submitted, complete sheets can be tabulated.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 sm:px-6"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg></span><div><h2 class="font-bold text-slate-950">Ranking ledger</h2><p class="mt-1 text-xs text-slate-500">Raw total is the sum of the judges' unweighted criterion scores. Weighted total is the sum across judges; average score is the mean weighted score per judge.</p></div></div>
  <div class="overflow-x-auto"><table class="w-full min-w-[1050px] text-left text-sm">
    <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Rank / placement</th><th class="px-5 py-4 font-bold">Contestant</th><th class="px-5 py-4 font-bold">Raw total</th><th class="px-5 py-4 font-bold">Weighted total</th><th class="px-5 py-4 font-bold">Average weighted score</th><th class="px-5 py-4 font-bold">Verification</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      {{#each results}}<tr class="transition hover:bg-amber-50/25"><td class="px-5 py-4"><div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-xl {{#if (eq rank 1)}}bg-amber-100 text-amber-800 ring-1 ring-amber-200{{else}}bg-slate-100 text-slate-700 ring-1 ring-slate-200{{/if}}"><span class="text-xs font-bold">#{{rank}}</span></span><div><p class="text-xs font-bold {{#if (eq rank 1)}}text-amber-800{{else}}text-slate-600{{/if}}">{{placementLabel}}</p></div></div></td><td class="px-5 py-4"><div class="flex items-center gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-amber-50 text-xs font-semibold text-amber-700 ring-1 ring-amber-100">{{#if Contestant.imageUrl}}<img src="{{Contestant.imageUrl}}" alt="{{contestantName}}" class="h-full w-full object-cover" loading="lazy" />{{else}}<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>{{/if}}</span><div><p class="font-semibold text-slate-900">{{contestantName}}</p><p class="mt-1 text-xs text-slate-500">{{#if Contestant}}{{Contestant.contestantNumber}}{{/if}}</p></div></div></td><td class="px-5 py-4 font-medium tabular-nums text-slate-700">{{totalRawScore}}</td><td class="px-5 py-4 font-semibold tabular-nums text-slate-800">{{totalWeightedScore}}</td><td class="px-5 py-4"><span class="inline-flex min-w-20 rounded-lg bg-violet-50 px-2.5 py-1.5 font-bold tabular-nums text-violet-800">{{averageScore}}</span></td><td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold capitalize {{#if (eq status 'published')}}border-emerald-200 bg-emerald-50 text-emerald-800{{else}}border-blue-200 bg-blue-50 text-blue-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq status 'published')}}bg-emerald-500{{else}}bg-blue-500{{/if}}"></span>{{status}}</span></td></tr>
      {{else}}<tr><td class="px-5 py-16 text-center" colspan="6"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg></span><p class="mt-4 font-semibold text-slate-700">No computed rankings yet</p><p class="mt-1 text-sm text-slate-500">Complete validation for this event, then compute rankings to create its verified ledger.</p></td></tr>{{/each}}
    </tbody>
  </table></div>
</section>
{{#if scoringOpen}}
<div id="computeModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="computeConfirmTitle"><div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl"><div class="flex h-11 w-11 items-center justify-center rounded-full bg-amber-50 text-lg font-bold text-amber-700">!</div><h2 id="computeConfirmTitle" class="mt-4 text-lg font-semibold text-slate-950">Compute verified rankings?</h2><p id="confirmActionMessage" class="mt-2 text-sm leading-6 text-slate-600">Computation checks every score and produces a result ledger. Once verified, results are locked for tabulator changes.</p><form id="computeForm" method="POST" class="mt-6 flex justify-end gap-3"><button type="button" onclick="closeModal('computeModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button id="confirmActionButton" class="rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-900">Compute rankings</button></form></div></div>
{{/if}}
{{else}}
<div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center"><h2 class="font-semibold text-slate-800">No assigned events</h2><p class="mt-1 text-sm text-slate-500">An organizer must assign an event before tabulation can begin.</p></div>
{{/if}}
{{> app-end}}
