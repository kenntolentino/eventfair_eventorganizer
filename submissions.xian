{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-amber-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-amber-300"></span>Judge record audit</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Score submissions</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Monitor judge submission status and check each submitted sheet against the contestant's applicable judging criteria.</p>
    </div>
    <a href="/tabulator/events" class="inline-flex items-center gap-2 self-start rounded-xl border border-white/15 bg-white/[0.08] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/[0.16] lg:self-auto"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg>Assigned events</a>
  </div>
</section>
<section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Submission overview">
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div><div class="flex items-start justify-between"><div><p class="text-xs font-semibold text-slate-500">Sheets shown</p><p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">{{stats.shown}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-blue-700">Current filter</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></div><div class="flex items-start justify-between"><div><p class="text-xs font-semibold text-slate-500">Submitted sheets</p><p class="mt-2 text-2xl font-bold tracking-tight text-emerald-800">{{stats.submitted}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-emerald-700">Received for review</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 {{#if stats.needsReview}}bg-amber-500{{else}}bg-emerald-500{{/if}}"></div><div class="flex items-start justify-between"><div><p class="text-xs font-semibold text-slate-500">Needs review</p><p class="mt-2 text-2xl font-bold tracking-tight {{#if stats.needsReview}}text-amber-800{{else}}text-emerald-800{{/if}}">{{stats.needsReview}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl {{#if stats.needsReview}}bg-amber-50 text-amber-700 ring-1 ring-amber-100{{else}}bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100{{/if}}"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] {{#if stats.needsReview}}text-amber-700{{else}}text-emerald-700{{/if}}">{{#if stats.needsReview}}Check incomplete sheets{{else}}All shown sheets complete{{/if}}</p></article>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 sm:px-6"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"/></svg></span><div><h2 class="font-bold text-slate-950">Judge score sheet audit</h2><p class="mt-1 text-xs text-slate-500">Filter records, inspect criterion-level scores, and review data quality.</p></div></div>
  <form method="GET" action="/tabulator/submissions" class="grid gap-3 border-b border-slate-100 bg-slate-50/60 p-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(12rem,0.7fr)_auto] lg:items-end sm:p-5">
    <div><label class="mb-1.5 block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500" for="submissionEvent">Assigned event</label><select id="submissionEvent" name="eventId" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-amber-500 focus:ring-4 focus:ring-amber-500/10"><option value="">All assigned events</option>{{#each events}}<option value="{{id}}" {{#if (eq ../filters.eventId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
    <div><label class="mb-1.5 block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500" for="submissionStatus">Submission status</label><select id="submissionStatus" name="status" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-amber-500 focus:ring-4 focus:ring-amber-500/10"><option value="">All statuses</option><option value="submitted" {{#if (eq filters.status 'submitted')}}selected{{/if}}>Submitted</option><option value="draft" {{#if (eq filters.status 'draft')}}selected{{/if}}>Draft</option></select></div>
    <div class="flex gap-2"><button class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 lg:flex-none"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16l-6.5 7.5V19l-3 1v-7.5L4 5Z"/></svg>Filter</button><a href="/tabulator/submissions" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 lg:flex-none">Reset</a></div>
  </form>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[1450px] text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Event / contestant</th><th class="px-5 py-4 font-bold">Judge</th><th class="px-5 py-4 font-bold">Criteria check</th><th class="px-5 py-4 font-bold">Status</th><th class="px-5 py-4 font-bold">Submitted</th><th class="px-5 py-4 font-bold">Judge scores</th><th class="px-5 py-4 font-bold">Audit</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each sheets}}
        <tr class="align-top transition hover:bg-amber-50/30">
          <td class="px-5 py-4"><div class="max-w-[17rem]"><p class="font-semibold text-slate-900">{{#if Event}}{{Event.name}}{{else}}Event unavailable{{/if}}</p><div class="mt-2 flex items-center gap-2.5"><span class="flex h-9 w-9 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-amber-50 text-xs font-semibold text-amber-700 ring-1 ring-amber-100">{{#if Contestant.imageUrl}}<img src="{{Contestant.imageUrl}}" alt="{{contestantName}}" class="h-full w-full object-cover" loading="lazy" />{{else}}<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>{{/if}}</span><div class="min-w-0"><p class="truncate text-xs font-medium text-slate-700">{{contestantName}}</p><p class="mt-0.5 text-[10px] text-slate-500">{{#if Contestant}}#{{Contestant.contestantNumber}}{{else}}Contestant unavailable{{/if}}</p></div></div></div></td>
          <td class="px-5 py-4"><div class="flex items-center gap-2"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-50 text-[10px] font-bold text-blue-700 ring-1 ring-blue-100">{{#if judgeName}}{{judgeName.[0]}}{{else}}J{{/if}}</span><span class="max-w-[10rem] font-medium text-slate-700">{{#if judgeName}}{{judgeName}}{{else}}Judge unavailable{{/if}}</span></div></td>
          <td class="whitespace-nowrap px-5 py-4"><p class="font-semibold text-slate-800">{{scoreCount}} <span class="font-normal text-slate-400">/ {{expectedScoreCount}}</span> entered</p><span class="mt-1.5 inline-flex items-center gap-1.5 rounded-full border px-2 py-1 text-[10px] font-semibold capitalize {{#if (eq quality 'complete')}}border-emerald-200 bg-emerald-50 text-emerald-800{{else}}border-amber-200 bg-amber-50 text-amber-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq quality 'complete')}}bg-emerald-500{{else}}bg-amber-500{{/if}}"></span>{{quality}}</span></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold capitalize {{#if (eq status 'submitted')}}border-blue-200 bg-blue-50 text-blue-800{{else}}border-slate-200 bg-slate-50 text-slate-700{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq status 'submitted')}}bg-blue-500{{else}}bg-slate-400{{/if}}"></span>{{status}}</span></td>
          <td class="whitespace-nowrap px-5 py-4"><p class="text-xs font-medium text-slate-700">{{#if submittedAt}}{{date submittedAt}}{{else}}—{{/if}}</p></td>
          <td class="px-5 py-4"><details class="min-w-52">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-amber-800 transition hover:border-amber-200 hover:bg-amber-50 [&::-webkit-details-marker]:hidden"><span>View {{scoreCount}} score{{#if (eq scoreCount 1)}}{{else}}s{{/if}} <span class="font-normal text-slate-500">· {{scoreBreakdown.weightedTotal}} weighted</span></span><svg class="h-3.5 w-3.5 flex-shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m7 10 5 5 5-5"/></svg></summary>
            <div class="mt-2 w-[24rem] max-w-[calc(100vw-3rem)] overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg">
              <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 px-3 py-2"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Criterion breakdown</p><p class="text-[10px] font-semibold text-slate-600">Weighted total: {{scoreBreakdown.weightedTotal}}</p></div>
              <table class="w-full text-left text-xs"><thead class="bg-white text-[9px] uppercase tracking-wide text-slate-500"><tr><th class="px-3 py-2 font-bold">Criterion</th><th class="px-2 py-2 text-right font-bold">Score</th><th class="px-2 py-2 text-right font-bold">Weight</th><th class="px-3 py-2 text-right font-bold">Weighted</th></tr></thead><tbody class="divide-y divide-slate-100">{{#each scoreBreakdown.scores}}<tr><td class="px-3 py-2.5 font-medium text-slate-700">{{criterionName}}</td><td class="whitespace-nowrap px-2 py-2.5 text-right tabular-nums text-slate-600">{{scoreValue}} / {{maxScore}}</td><td class="px-2 py-2.5 text-right tabular-nums text-slate-600">{{weight}}%</td><td class="px-3 py-2.5 text-right font-semibold tabular-nums text-slate-800">{{weightedScore}}</td></tr>{{else}}<tr><td colspan="4" class="px-3 py-5 text-center text-slate-500">No scores in this sheet.</td></tr>{{/each}}</tbody><tfoot class="border-t border-slate-200 bg-slate-50 font-semibold text-slate-700"><tr><td colspan="3" class="px-3 py-2.5">Raw total / weighted total</td><td class="px-3 py-2.5 text-right tabular-nums">{{scoreBreakdown.rawTotal}} / {{scoreBreakdown.weightedTotal}}</td></tr></tfoot></table>
            </div>
          </details></td>
          <td class="max-w-xs px-5 py-4">{{#if qualityErrors.length}}<div class="space-y-1.5">{{#each qualityErrors}}<p class="flex items-start gap-1.5 text-xs leading-5 text-amber-800"><span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-amber-500"></span>{{this}}</p>{{/each}}</div>{{else}}<p class="flex items-start gap-1.5 text-xs leading-5 text-emerald-800"><svg class="mt-0.5 h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg>All applicable criteria are present and within range.</p>{{/if}}</td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="7"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span><p class="mt-4 font-semibold text-slate-800">No score sheets match</p><p class="mt-1 text-sm text-slate-500">Submitted and draft records from your assigned events will appear here.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{> app-end}}
