<label class="mb-1 block text-sm font-semibold text-slate-700">Assigned event</label>
<select name="eventId" required class="mb-4 w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-amber-500"><option value="">Select event</option>{{#each events}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
<label class="mb-1 block text-sm font-semibold text-slate-700">Contestant (optional)</label>
<select name="contestantId" class="mb-4 w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-amber-500"><option value="">Event-level issue</option>{{#each contestants}}<option value="{{id}}">{{fullName}} · {{contestantNumber}}</option>{{/each}}</select>
<label class="mb-1 block text-sm font-semibold text-slate-700">Issue title</label>
<input name="title" maxlength="255" required class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-amber-500" placeholder="Briefly describe the discrepancy" />
<label class="mb-1 block text-sm font-semibold text-slate-700">Issue details</label>
<textarea name="description" rows="4" class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-amber-500" placeholder="Include the affected score sheet or criterion and the observed inconsistency"></textarea>
<label class="mb-1 block text-sm font-semibold text-slate-700">Review status</label>
<select name="status" class="mb-4 w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-amber-500"><option value="open">Open</option><option value="under_review">Under review</option><option value="resolved">Resolved</option></select>
<label class="mb-1 block text-sm font-semibold text-slate-700">Resolution notes</label>
<textarea name="resolutionNotes" rows="3" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-amber-500" placeholder="Document the authorized correction or reason for resolution"></textarea>
