{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-fair-900 to-fair-800 px-6 py-7 text-white shadow-xl shadow-slate-900/10 sm:px-8 sm:py-9">
  <div class="pointer-events-none absolute -right-10 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -right-2 -top-12 h-48 w-48 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -bottom-28 right-40 h-56 w-56 rounded-full bg-fair-500/20 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        SYSTEM REPORTING
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Reports &amp; analytics</h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300 sm:text-base">Track accounts, event activity, judge submissions, and verified tabulation results with live system reporting.</p>
    </div>
    <a href="/admin/reports?format=csv{{#if filters.status}}&amp;status={{filters.status}}{{/if}}" class="inline-flex items-center justify-center gap-2 rounded-xl bg-fair-gold px-4 py-2.5 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-amber-300">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 17v3h14v-3"/></svg>
      Export filtered report (CSV)
    </a>
  </div>
</section>

<section class="mb-7 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Report totals">
  <article class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-slate-500">User accounts</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.users}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Across all system roles</p>
  </article>
  <article class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-slate-500">Events in report</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.events}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Based on selected status filter</p>
  </article>
  <article class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-slate-500">Submitted score sheets</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.submittedSheets}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M14 3v5h5m-9 5 2 2 4-4"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Draft sheets are reported separately</p>
  </article>
  <article class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-medium text-slate-500">Verified results</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.verifiedResults}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Official verified tabulation records</p>
  </article>
</section>

<section class="mb-7 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-col justify-between gap-4 border-b border-slate-100 bg-gradient-to-r from-white to-blue-50/40 px-5 py-5 sm:flex-row sm:items-center sm:px-6">
    <div class="flex items-start gap-3">
      <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span>
      <div><h2 class="text-base font-bold text-slate-950">Accounts by role</h2><p class="mt-1 text-sm text-slate-500">Current system account counts from the database.</p></div>
    </div>
    <div class="flex flex-wrap gap-2">
      {{#each roleCounts}}
      <span class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 shadow-sm">{{label}} <strong class="rounded-md bg-slate-100 px-1.5 py-0.5 tabular-nums text-slate-950">{{count}}</strong></span>
      {{/each}}
    </div>
  </div>
</section>

<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-col justify-between gap-4 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:px-6">
    <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-fair-700">Event performance</p><h2 class="mt-1 text-lg font-bold text-slate-950">Event and scoring activity</h2><p class="mt-1 text-sm text-slate-500">Expected score sheets are calculated from assigned judges × registered contestants.</p></div>
    <form method="get" action="/admin/reports" class="flex flex-wrap gap-2">
      <label class="sr-only" for="reportStatus">Filter by event status</label>
      <select id="reportStatus" name="status" class="min-w-40 rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-fair-500 focus:ring-4 focus:ring-fair-500/10">
        <option value="">All statuses</option>
        {{#each statuses}}
        <option value="{{value}}" {{#if (eq ../filters.status value)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      <button class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700">Apply filter</button>
    </form>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-[1050px] w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50/80 text-[10px] uppercase tracking-[0.1em] text-slate-500">
        <tr>
          <th scope="col" class="px-5 py-3.5 font-bold sm:px-6">Event</th>
          <th scope="col" class="px-5 py-3.5 font-bold sm:px-6">Status</th>
          <th scope="col" class="px-4 py-3.5 text-right font-bold">Judges</th>
          <th scope="col" class="px-4 py-3.5 text-right font-bold">Contestants</th>
          <th scope="col" class="px-4 py-3.5 text-right font-bold">Expected sheets</th>
          <th scope="col" class="px-4 py-3.5 text-right font-bold">Submitted</th>
          <th scope="col" class="px-4 py-3.5 text-right font-bold">Drafts</th>
          <th scope="col" class="px-5 py-3.5 text-right font-bold sm:px-6">Verified results</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {{#each events}}
        <tr class="transition-colors hover:bg-blue-50/30">
          <td class="px-5 py-4 sm:px-6">
            <p class="font-semibold text-slate-900">{{name}}</p>
            <p class="mt-1 text-xs text-slate-500">{{#if startDate}}{{date startDate}}{{else}}No start date{{/if}}</p>
          </td>
          <td class="whitespace-nowrap px-5 py-4 sm:px-6"><span class="inline-flex rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-[11px] font-semibold capitalize text-slate-700">{{status}}</span></td>
          <td class="px-4 py-4 text-right tabular-nums text-slate-700">{{judges}}</td>
          <td class="px-4 py-4 text-right tabular-nums text-slate-700">{{contestants}}</td>
          <td class="px-4 py-4 text-right tabular-nums text-slate-700">{{expectedSheets}}</td>
          <td class="px-4 py-4 text-right tabular-nums font-semibold text-emerald-700">{{submittedSheets}}</td>
          <td class="px-4 py-4 text-right tabular-nums {{#if draftSheets}}font-semibold text-amber-700{{else}}text-slate-500{{/if}}">{{draftSheets}}</td>
          <td class="px-5 py-4 text-right tabular-nums font-semibold text-slate-900 sm:px-6">{{verifiedResults}}</td>
        </tr>
        {{else}}
        <tr><td colspan="8" class="px-5 py-14 text-center"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></span><p class="mt-3 font-semibold text-slate-700">No event records found</p><p class="mt-1 text-sm text-slate-500">No event records match this filter.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  <p class="flex items-start gap-2 border-t border-slate-100 bg-slate-50/60 px-5 py-4 text-xs leading-5 text-slate-500 sm:px-6"><svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 11v5m0-8h.01"/></svg>Expected sheets are a planning estimate; judges may not be required to score every contestant in every event.</p>
</section>
{{> app-end}}
