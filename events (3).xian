{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-violet-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-violet-300"></span>My assignments</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Assigned events</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Review each competition's schedule, instructions, scoring policy, and your submission progress.</p>
    </div>
    <a href="/judge/scoring" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">Open score entry<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
  </div>
</section>

<section class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <div><h2 class="text-lg font-bold text-slate-950">Your competition schedule</h2><p class="mt-1 text-sm text-slate-500">Event guidance and evaluation status for your assignments.</p></div>
  <span class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-800"><span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>{{events.length}} assigned</span>
</section>

<section class="grid grid-cols-1 gap-5 xl:grid-cols-2" aria-label="Assigned events">
  {{#each events}}
  <article class="group overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/70">
    <div class="relative overflow-hidden border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-blue-50/60 p-5 sm:p-6">
      <div class="pointer-events-none absolute -right-8 -top-12 h-36 w-36 rounded-full border border-blue-100/70"></div>
      <div class="relative flex flex-wrap items-start justify-between gap-3">
        <div class="flex min-w-0 items-start gap-3">
          <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-800 ring-1 ring-blue-200/70"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span>
          <div class="min-w-0"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Assigned competition</p><h2 class="mt-1 text-lg font-bold leading-snug text-slate-950 sm:text-xl">{{name}}</h2></div>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full border {{#if scoringOpen}}border-violet-200 bg-violet-50 text-violet-800{{else}}border-slate-200 bg-white text-slate-600{{/if}} px-2.5 py-1 text-[11px] font-semibold capitalize"><span class="h-1.5 w-1.5 rounded-full {{#if scoringOpen}}bg-violet-500{{else}}bg-slate-400{{/if}}"></span>{{status}}</span>
      </div>
      <div class="relative mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-slate-600">
        <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>{{#if venue}}{{venue}}{{else}}Venue not announced{{/if}}</span>
        <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg>{{#if startDate}}{{startDate}}{{else}}Date not set{{/if}}{{#if endDate}} – {{endDate}}{{/if}}</span>
      </div>
      {{#if description}}<p class="relative mt-3 max-w-2xl text-sm leading-6 text-slate-600">{{description}}</p>{{/if}}
    </div>
    <div class="space-y-5 p-5 sm:p-6">
      <div class="flex items-start gap-3">
        <span class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-violet-50 text-violet-700"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span>
        <div><p class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Evaluation instructions</p><p class="mt-1 text-sm leading-6 text-slate-700">{{#if evaluationInstructions}}{{evaluationInstructions}}{{else}}No additional instructions have been provided. Follow the published criteria and scoring guidelines.{{/if}}</p></div>
      </div>
      <div class="rounded-xl border border-slate-200/80 bg-slate-50/80 p-4">
        <div class="flex items-center justify-between gap-3"><div class="flex items-center gap-2"><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-emerald-700 ring-1 ring-slate-200"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg></span><p class="text-sm font-bold text-slate-800">My submission progress</p></div><p class="text-sm font-bold tabular-nums text-slate-800">{{completion}}%</p></div>
        <div class="mt-3 flex items-center justify-between gap-3 text-xs"><span class="font-semibold tabular-nums text-slate-700">{{submitted}} <span class="font-normal text-slate-400">/ {{contestantCount}} submitted</span></span><span class="text-slate-500">{{remaining}} remaining</span></div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200"><div class="h-full max-w-full rounded-full {{#if (eq completion 100)}}bg-emerald-500{{else}}bg-gradient-to-r from-violet-600 to-blue-500{{/if}}" style="width: {{completion}}%"></div></div>
        {{#if drafts}}<p class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>{{drafts}} draft(s) need review</p>{{/if}}
      </div>
      <div class="flex flex-col gap-2 border-t border-slate-100 pt-4 sm:flex-row sm:flex-wrap">
        <a href="/judge/criteria?eventId={{id}}" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-violet-200 hover:bg-violet-50 hover:text-violet-900"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>Review criteria</a>
        <a href="/judge/contestants?eventId={{id}}" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-900"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg>View contestants</a>
        <a href="/judge/scoring?eventId={{id}}" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#102947] px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65] sm:ml-auto">{{#if scoringOpen}}Open score entry{{else}}Review submissions{{/if}}<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
      </div>
    </div>
  </article>
  {{else}}
  <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center shadow-sm xl:col-span-2">
    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span>
    <h2 class="mt-4 font-semibold text-slate-800">No assigned events</h2>
    <p class="mx-auto mt-1 max-w-md text-sm leading-6 text-slate-500">When an organizer assigns you to a competition, the event details and judging instructions will appear here.</p>
  </div>
  {{/each}}
</section>
{{> app-end}}
