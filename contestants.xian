{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-violet-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-violet-300"></span>Assigned roster</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Contestants</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">View contestant details for your assigned events. Use the roster to prepare fair, criteria-based evaluations.</p>
    </div>
    <a href="/judge/scoring" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">Open score entry<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
  </div>
</section>

<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span><div><h2 class="text-base font-bold text-slate-950">Contestant roster</h2><p class="mt-0.5 text-xs text-slate-500 sm:text-sm">Review contestant profiles and evaluation eligibility.</p></div></div>
    <span class="inline-flex items-center gap-2 rounded-full border border-violet-100 bg-violet-50 px-3 py-1.5 text-xs font-semibold text-violet-800"><span class="h-1.5 w-1.5 rounded-full bg-violet-600"></span>{{stats.total}} shown</span>
  </div>
  <form method="GET" action="/judge/contestants" class="grid grid-cols-1 gap-3 border-b border-slate-100 bg-slate-50/60 p-4 sm:grid-cols-2 sm:p-5 xl:grid-cols-[minmax(240px,1fr)_220px_220px_auto] xl:items-end">
    <label class="sr-only" for="judgeContestantSearch">Search contestants</label>
    <div class="relative"><svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/></svg><input id="judgeContestantSearch" name="q" value="{{filters.q}}" placeholder="Search name, number, organization" class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10" /></div>
    <label class="sr-only" for="judgeContestantEvent">Filter by event</label><select id="judgeContestantEvent" name="eventId" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10"><option value="">All assigned events</option>{{#each events}}<option value="{{id}}" {{#if (eq ../filters.eventId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <label class="sr-only" for="judgeContestantStatus">Filter by status</label><select id="judgeContestantStatus" name="status" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10"><option value="">All contestant statuses</option><option value="registered" {{#if (eq filters.status 'registered')}}selected{{/if}}>Registered</option><option value="withdrawn" {{#if (eq filters.status 'withdrawn')}}selected{{/if}}>Withdrawn</option><option value="disqualified" {{#if (eq filters.status 'disqualified')}}selected{{/if}}>Disqualified</option></select>
    <div class="flex gap-2"><button class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65] xl:flex-none"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16l-6.5 7.5v5L10.5 19v-6.5L4 5Z"/></svg>Filter roster</button><a href="/judge/contestants" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 xl:flex-none">Reset</a></div>
  </form>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-3 sm:px-6"><p class="text-xs font-semibold text-slate-600">Contestant records</p><p class="text-xs text-slate-500">Showing <span class="font-semibold text-slate-800">{{stats.total}}</span> matching contestants</p></div>
  <div class="overflow-x-auto">
    <table class="min-w-[900px] w-full text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Contestant</th><th class="px-5 py-4 font-bold">Event &amp; category</th><th class="px-5 py-4 font-bold">Profile</th><th class="px-5 py-4 font-bold">Status</th><th class="px-5 py-4 text-right font-bold">Evaluation</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each contestants}}
        <tr class="transition hover:bg-violet-50/30">
          <td class="px-5 py-4"><div class="flex items-center gap-3"><div class="flex h-11 w-11 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-violet-50 to-blue-100 text-xs font-bold text-violet-700 ring-1 ring-violet-100">{{#if imageUrl}}<img src="{{imageUrl}}" alt="{{fullName}}" class="h-full w-full object-cover" loading="lazy" />{{else}}<span aria-hidden="true">{{contestantNumber}}</span>{{/if}}</div><div><p class="font-semibold text-slate-900">{{fullName}}</p><p class="mt-1 text-xs text-slate-500">Contestant #{{contestantNumber}}</p></div></div></td>
          <td class="px-5 py-4"><p class="font-medium text-slate-800">{{#if Event}}{{Event.name}}{{else}}—{{/if}}</p><p class="mt-1 inline-flex items-center gap-1.5 text-xs text-slate-500"><span class="h-1.5 w-1.5 rounded-full bg-violet-400"></span>{{#if Category}}{{Category.name}}{{else}}General category{{/if}}</p></td>
          <td class="px-5 py-4"><p class="text-slate-700">{{#if organization}}{{organization}}{{else}}<span class="text-slate-400">Organization not listed</span>{{/if}}</p><p class="mt-1 text-xs text-slate-500">{{#if age}}{{age}} years{{/if}}{{#if gender}}{{#if age}} · {{/if}}{{gender}}{{/if}}</p></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border {{#if (eq status 'registered')}}border-emerald-200 bg-emerald-50 text-emerald-800{{else if (eq status 'withdrawn')}}border-amber-200 bg-amber-50 text-amber-800{{else}}border-rose-200 bg-rose-50 text-rose-800{{/if}} px-2.5 py-1 text-[11px] font-semibold capitalize"><span class="h-1.5 w-1.5 rounded-full {{#if (eq status 'registered')}}bg-emerald-500{{else if (eq status 'withdrawn')}}bg-amber-500{{else}}bg-rose-500{{/if}}"></span>{{status}}</span></td>
          <td class="whitespace-nowrap px-5 py-4 text-right">{{#if (eq status 'registered')}}<a href="/judge/scoring?eventId={{Event.id}}" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-bold text-violet-800 transition hover:bg-violet-50 hover:text-violet-950">Open evaluation<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a>{{else}}<span class="inline-flex items-center gap-1.5 text-xs text-slate-400"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M9 9l6 6m0-6-6 6"/></svg>Not eligible for scoring</span>{{/if}}</td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="5"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/></svg></span><p class="mt-4 font-semibold text-slate-800">No matching contestants</p><p class="mt-1 text-sm text-slate-500">Try changing the event, status, or search filters.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{> app-end}}
