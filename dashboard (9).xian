{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-amber-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-amber-300"></span>Tabulation workspace</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Results verification dashboard</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Audit submitted score sheets, resolve discrepancies, verify complete rubrics, and generate rankings from the event's approved scoring formula.</p>
    </div>
    <a href="/tabulator/submissions" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/[0.10] px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:border-white/25 hover:bg-white/[0.17]">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
      Review submissions
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
    </a>
  </div>
</section>
<section class="mb-7 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-6" aria-label="Tabulation overview">
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">Assigned events</p><p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">{{stats.events}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-blue-700">Tabulation queue</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="absolute inset-x-0 top-0 h-1 bg-violet-500"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">Submitted sheets</p><p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">{{stats.submitted}} <span class="text-sm font-medium text-slate-400">/ {{stats.expected}}</span></p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-violet-700">Received / expected</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="absolute inset-x-0 top-0 h-1 {{#if stats.incomplete}}bg-amber-500{{else}}bg-emerald-500{{/if}}"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">Incomplete contestants</p><p class="mt-2 text-2xl font-bold tracking-tight {{#if stats.incomplete}}text-amber-800{{else}}text-emerald-800{{/if}}">{{stats.incomplete}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl {{#if stats.incomplete}}bg-amber-50 text-amber-700 ring-1 ring-amber-100{{else}}bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100{{/if}}"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] {{#if stats.incomplete}}text-amber-700{{else}}text-emerald-700{{/if}}">{{#if stats.incomplete}}Needs completion{{else}}All contestants ready{{/if}}</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="absolute inset-x-0 top-0 h-1 {{#if stats.openIssues}}bg-rose-500{{else}}bg-emerald-500{{/if}}"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">Open discrepancies</p><p class="mt-2 text-2xl font-bold tracking-tight {{#if stats.openIssues}}text-rose-800{{else}}text-emerald-800{{/if}}">{{stats.openIssues}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl {{#if stats.openIssues}}bg-rose-50 text-rose-700 ring-1 ring-rose-100{{else}}bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100{{/if}}"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" d="M12 9v4m0 3h.01"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] {{#if stats.openIssues}}text-rose-700{{else}}text-emerald-700{{/if}}">{{#if stats.openIssues}}Requires review{{else}}No open issues{{/if}}</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="absolute inset-x-0 top-0 h-1 bg-indigo-500"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">Computed rankings</p><p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">{{stats.results}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700 ring-1 ring-indigo-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-indigo-700">Verified result sets</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">Ready to compute</p><p class="mt-2 text-2xl font-bold tracking-tight text-emerald-800">{{stats.ready}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-emerald-700">Awaiting computation</p></article>
</section>
<section class="mb-7 overflow-hidden rounded-2xl border border-amber-200/80 bg-gradient-to-r from-amber-50 via-white to-orange-50 shadow-sm">
  <div class="flex items-start gap-4 p-5 sm:p-6"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-800 ring-1 ring-amber-200"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 10V7a4 4 0 1 1 8 0v3"/></svg></span><div><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-amber-800">Confidential workflow</p><h2 class="mt-1 font-bold text-amber-950">Protect result confidentiality</h2><p class="mt-1 max-w-4xl text-sm leading-6 text-amber-900">Keep rankings and judge-level records confidential until the event organizer approves publication. Computed rankings are marked verified and become read-only for tabulation.</p></div></div>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:px-6"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"/></svg></span><div><h2 class="font-bold text-slate-950">Event processing status</h2><p class="mt-1 text-xs text-slate-500">Completeness counts include only valid sheets from judges assigned to each event.</p></div></div><a href="/tabulator/events" class="inline-flex items-center gap-1 self-start rounded-lg px-3 py-2 text-xs font-bold text-amber-800 transition hover:bg-amber-50 hover:text-amber-950 sm:self-auto">View assigned events<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[860px] text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Event</th><th class="px-5 py-4 font-bold">Phase</th><th class="px-5 py-4 font-bold">Valid sheets</th><th class="px-5 py-4 font-bold">Review items</th><th class="px-5 py-4 font-bold">Results</th><th class="px-5 py-4 text-right font-bold">Workflow</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each events}}
        <tr class="transition hover:bg-amber-50/30">
          <td class="px-5 py-4"><div class="flex items-center gap-3"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-amber-50 to-orange-100 text-amber-800 ring-1 ring-amber-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><div><p class="font-semibold text-slate-900">{{name}}</p><p class="mt-1 text-xs text-slate-500">{{judges}} judges <span class="mx-1 text-slate-300">·</span> {{contestantCount}} registered contestants</p></div></div></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold capitalize text-slate-700"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>{{status}}</span></td>
          <td class="px-5 py-4"><p class="font-bold text-slate-800">{{completeSheets}} <span class="font-medium text-slate-400">/ {{expectedSheets}}</span></p><p class="mt-1 text-[10px] text-slate-500">complete / expected</p></td>
          <td class="px-5 py-4"><p class="font-semibold {{#if incompleteContestants}}text-amber-800{{else}}text-emerald-800{{/if}}">{{incompleteContestants}} contestants</p><p class="mt-1 text-xs text-slate-500">{{openIssues}} open discrepancies <span class="mx-1 text-slate-300">·</span> {{unassignedSheets}} unassigned sheets</p></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 font-semibold text-slate-800"><svg class="h-4 w-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg>{{resultCount}} ranked</span></td>
          <td class="whitespace-nowrap px-5 py-4 text-right"><a href="/tabulator/computation?eventId={{id}}" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-bold text-amber-800 transition hover:bg-amber-50 hover:text-amber-950">{{#if (eq status 'tabulated')}}Review verified{{else if (eq status 'published')}}Review published{{else}}Open tabulation{{/if}}<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a></td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="6"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><p class="mt-4 font-semibold text-slate-800">No event assignments yet</p><p class="mt-1 text-sm text-slate-500">Events assigned by an organizer will appear here.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{> app-end}}
