<label class="mb-1 block text-sm font-semibold text-slate-700">Full name</label>
<input name="name" required autocomplete="name" class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-fair-500 focus:ring-2 focus:ring-fair-500/20" />
<label class="mb-1 block text-sm font-semibold text-slate-700">Email address</label>
<input type="email" name="email" required autocomplete="email" class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-fair-500 focus:ring-2 focus:ring-fair-500/20" />
<label class="mb-1 block text-sm font-semibold text-slate-700">Password</label>
<div class="relative mb-1" data-password-field>
  <input type="password" name="password" autocomplete="new-password" {{#if requiredPassword}}required minlength="8"{{/if}} class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 pr-12 text-sm outline-none focus:border-fair-500 focus:ring-2 focus:ring-fair-500/20" />
  <button type="button" data-password-toggle aria-label="Show password" aria-pressed="false" class="absolute inset-y-0 right-0 inline-flex w-12 items-center justify-center rounded-r-xl text-slate-500 transition hover:text-fair-700 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-fair-500">
    <svg data-password-eye class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"/><circle cx="12" cy="12" r="3"/></svg>
    <svg data-password-eye-off class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path stroke-linecap="round" stroke-linejoin="round" d="M9.9 5.2A10.7 10.7 0 0 1 12 5c6 0 9.5 7 9.5 7a17.8 17.8 0 0 1-3.1 3.9M6.2 6.2C3.9 7.8 2.5 12 2.5 12s3.5 7 9.5 7c1 0 1.9-.2 2.8-.5"/></svg>
  </button>
</div>
<p class="mb-4 text-xs text-slate-500">{{#if requiredPassword}}Use at least 8 characters.{{else}}Leave blank to keep the existing password.{{/if}}</p>
<div class="grid gap-4 sm:grid-cols-2">
  <div>
    <label class="mb-1 block text-sm font-semibold text-slate-700">System role</label>
    <select name="role" required class="mb-4 w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-fair-500">
      {{#each roles}}<option value="{{value}}">{{label}}</option>{{/each}}
    </select>
  </div>
  <div>
    <label class="mb-1 block text-sm font-semibold text-slate-700">Account status</label>
    <select name="status" class="mb-4 w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-fair-500">
      <option value="active">Active</option>
      <option value="inactive">Inactive</option>
    </select>
  </div>
</div>
<div class="grid gap-4 sm:grid-cols-2">
  <div>
    <label class="mb-1 block text-sm font-semibold text-slate-700">Phone</label>
    <input name="phone" autocomplete="tel" class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-fair-500" />
  </div>
  <div>
    <label class="mb-1 block text-sm font-semibold text-slate-700">Organization</label>
    <input name="organization" autocomplete="organization" class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-fair-500" />
  </div>
</div>
