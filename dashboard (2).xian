{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-violet-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-7 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-violet-300"></span>Judge workspace</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Your judging dashboard</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Review event guidance, complete each assigned evaluation, and submit scores before the judging period closes.</p>
    </div>
    <a href="/judge/scoring" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">
      Continue score entry
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
    </a>
  </div>
  <div class="relative mt-7 flex flex-wrap gap-x-6 gap-y-2 border-t border-white/10 pt-5 text-xs font-medium text-blue-100/75">
    <a href="/judge/events" class="transition hover:text-white">Assigned events <span class="ml-1 text-white/40" aria-hidden="true">&rarr;</span></a>
    <a href="/judge/contestants" class="transition hover:text-white">Contestants <span class="ml-1 text-white/40" aria-hidden="true">&rarr;</span></a>
    <a href="/judge/criteria" class="transition hover:text-white">Criteria &amp; guidelines <span class="ml-1 text-white/40" aria-hidden="true">&rarr;</span></a>
  </div>
</section>

<section class="mb-7 grid grid-cols-1 gap-4 sm:grid-cols-2 2xl:grid-cols-5" aria-label="Judge summary">
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Assigned events</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.events}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">Your schedule</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-violet-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Currently judging</p><p class="mt-3 text-3xl font-bold tracking-tight text-violet-800">{{stats.openEvents}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-violet-700">Open evaluations</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Submitted evaluations</p><p class="mt-3 text-3xl font-bold tracking-tight text-emerald-800">{{stats.submitted}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/><circle cx="12" cy="12" r="9"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Completed sheets</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-amber-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Draft evaluations</p><p class="mt-3 text-3xl font-bold tracking-tight text-amber-800">{{stats.drafts}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9"/><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-amber-700">Needs your review</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-rose-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Contestants to review</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.remaining}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-50 text-rose-700 ring-1 ring-rose-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-rose-700">Remaining workload</p>
  </article>
</section>

<section class="mb-7 overflow-hidden rounded-2xl border border-violet-200/80 bg-gradient-to-r from-violet-50 via-white to-blue-50 shadow-sm">
  <div class="flex items-start gap-4 p-5 sm:p-6">
    <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-800 ring-1 ring-violet-200"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 3h.01"/></svg></span>
    <div><h2 class="text-sm font-bold text-violet-950">Independent and confidential evaluation</h2><p class="mt-1 text-sm leading-6 text-violet-900/90">Score each contestant using the published rubric. Your individual scores and remarks are private to your judge account and authorized tabulation workflow.</p></div>
  </div>
</section>

<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><div><h2 class="text-base font-bold text-slate-950">Assigned event workload</h2><p class="mt-0.5 text-xs text-slate-500">Submission progress is shown only for your own score sheets.</p></div></div>
    <a href="/judge/events" class="inline-flex items-center gap-1 text-sm font-semibold text-blue-800 transition hover:text-blue-950">View all events <span aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-[900px] w-full text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Event</th><th class="px-5 py-4 font-bold">Schedule</th><th class="px-5 py-4 font-bold">My progress</th><th class="px-5 py-4 font-bold">Phase</th><th class="px-5 py-4 text-right font-bold">Action</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each events}}
        <tr class="transition hover:bg-blue-50/40">
          <td class="px-5 py-4"><div class="flex items-start gap-3"><span class="mt-0.5 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-50 to-indigo-100 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><div><p class="font-semibold text-slate-900">{{name}}</p><p class="mt-1 text-xs text-slate-500">{{#if venue}}{{venue}}{{else}}Venue to be announced{{/if}}</p></div></div></td>
          <td class="px-5 py-4"><span class="inline-flex items-start gap-2 whitespace-nowrap text-xs text-slate-600"><svg class="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg>{{#if startDate}}{{startDate}}{{else}}Date not set{{/if}}{{#if endDate}} – {{endDate}}{{/if}}</span></td>
          <td class="min-w-52 px-5 py-4"><div class="flex items-center justify-between gap-3"><span class="font-semibold tabular-nums text-slate-800">{{submitted}} <span class="font-normal text-slate-400">/ {{contestantCount}}</span></span><span class="text-xs font-bold tabular-nums {{#if (eq completion 100)}}text-emerald-700{{else}}text-slate-600{{/if}}">{{completion}}%</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full max-w-full rounded-full {{#if (eq completion 100)}}bg-emerald-500{{else}}bg-gradient-to-r from-violet-600 to-blue-500{{/if}}" style="width: {{completion}}%"></div></div><p class="mt-1 text-[10px] text-slate-400">evaluations submitted</p>{{#if drafts}}<p class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>{{drafts}} draft(s) need review</p>{{/if}}</td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border {{#if scoringOpen}}border-violet-200 bg-violet-50 text-violet-800{{else}}border-slate-200 bg-slate-50 text-slate-600{{/if}} px-2.5 py-1 text-[11px] font-semibold capitalize"><span class="h-1.5 w-1.5 rounded-full {{#if scoringOpen}}bg-violet-500{{else}}bg-slate-400{{/if}}"></span>{{status}}</span></td>
          <td class="whitespace-nowrap px-5 py-4 text-right"><a href="/judge/scoring?eventId={{id}}" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-bold text-violet-800 transition hover:bg-violet-50 hover:text-violet-950">{{#if scoringOpen}}Open evaluations{{else}}Review event{{/if}}<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a></td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="5"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><p class="mt-4 font-semibold text-slate-800">No event assignments yet</p><p class="mt-1 text-sm text-slate-500">Events assigned by an organizer will appear here.</p><a href="/judge/events" class="mt-4 inline-flex items-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#193e65]">View assigned events <span aria-hidden="true">&rarr;</span></a></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{> app-end}}
