<style>
  #organizerSidebar { background: linear-gradient(145deg, #0b1429 0%, #102947 55%, #193e65 100%); border-color: rgba(255, 255, 255, 0.12); color: #eaf3ff; }
  #organizerSidebar > div:nth-of-type(2) { border-color: rgba(255, 255, 255, 0.12); background: transparent; }
  #organizerSidebar nav p { color: #a9c5e3; }
  #organizerSidebar nav a:not([aria-current="page"]) { border-color: transparent; color: #dbeafe; }
  #organizerSidebar nav a:not([aria-current="page"]):hover { border-color: rgba(255, 255, 255, 0.14); background-color: rgba(255, 255, 255, 0.1); color: #fff; }
  #organizerSidebar nav a[aria-current="page"] { border-color: #fff; background-color: #fff; color: #102947; box-shadow: 0 6px 16px rgba(8, 30, 55, 0.18); }
  #organizerSidebar nav a[aria-current="page"] span:first-child { background-color: #dbeafe; color: #102947; }
  #organizerSidebar > div:last-child { border-color: rgba(255, 255, 255, 0.12); background-color: transparent; }
  #organizerSidebar > div:last-child p:first-child { color: #fff; }
  #organizerSidebar > div:last-child p:nth-child(2) { color: #a9c5e3; }
  #organizerSidebar > div:last-child a { border-color: rgba(255, 255, 255, 0.2); background-color: transparent; color: #fff; }
  #organizerSidebar > div:last-child a svg,
  #organizerSidebar > div:last-child a span:last-child { color: #bfdbfe; }
  #organizerSidebar > div:last-child a:hover { border-color: #fecdd3; background-color: rgba(244, 63, 94, 0.14); color: #fff; }
</style>
<aside id="organizerSidebar" class="hidden fixed inset-y-0 left-0 z-50 flex w-72 min-h-screen flex-col overflow-hidden border-r border-blue-800 text-blue-50 shadow-2xl lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-64 lg:flex-shrink-0 lg:shadow-none">
  <div class="pointer-events-none absolute -left-24 top-32 h-64 w-64 rounded-full bg-blue-100/70 opacity-0 blur-3xl"></div>
  <div class="relative border-b border-slate-200/80 bg-gradient-to-br from-fair-900 via-fair-900 to-fair-800 px-5 pb-5 pt-6">
    <div class="flex items-center justify-between">
      <a href="/organizer/dashboard" class="group flex items-center gap-3">
        {{#if content.brand.logo}}
        <img src="{{content.brand.logo}}" alt="{{content.brand.name}} logo" class="h-11 w-11 rounded-2xl bg-white object-contain p-1.5 shadow-lg shadow-black/10 transition group-hover:scale-105" />
        {{else}}
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-white/15 bg-white/10 text-sm font-black tracking-tight text-fair-gold shadow-lg shadow-black/10 backdrop-blur transition group-hover:scale-105">EF</span>
        {{/if}}
        <span>
          <span class="block text-base font-bold tracking-wide text-white">{{content.brand.name}}</span>
          <span class="mt-0.5 block text-[10px] font-semibold uppercase tracking-[0.16em] text-blue-100/60">Organizer workspace</span>
        </span>
      </a>
      <button type="button" aria-label="Close navigation" class="rounded-lg p-2 text-blue-100/70 transition hover:bg-white/10 hover:text-white lg:hidden" onclick="toggleSidebar('organizerSidebar','organizerSidebarOverlay')">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="mt-6 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.07] p-3 shadow-sm backdrop-blur">
      <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-white/10 text-blue-100 ring-1 ring-white/10" aria-hidden="true">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.25"/><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg>
      </span>
      <div class="min-w-0">
        <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-blue-100/50">Signed in as</p>
        <p class="mt-0.5 text-xs font-semibold text-blue-100/75">Event Organizer</p>
        <p class="mt-0.5 truncate text-sm font-semibold text-white">{{currentUser.name}}</p>
      </div>
      <span class="ml-auto h-2 w-2 flex-shrink-0 rounded-full bg-emerald-500 ring-4 ring-emerald-100" title="Signed in"></span>
    </div>
  </div>

  <nav aria-label="Organizer navigation" class="relative flex-1 space-y-6 overflow-y-auto px-3 py-5">
    <div>
      <p class="mb-2 px-3 text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">Overview</p>
      <a href="/organizer/dashboard" {{#if (eq nav 'dashboard')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2.5 text-sm font-medium transition">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70 transition">
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="8" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="15" width="7" height="6" rx="1.5"/></svg>
        </span>
        <span class="flex-1">Dashboard</span>{{#if (eq nav 'dashboard')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
      </a>
    </div>

    <div>
      <p class="mb-2 px-3 text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">Competition setup</p>
      <div class="space-y-1">
        <a href="/organizer/events" {{#if (eq nav 'events')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span>
          <span class="flex-1">Event setup</span>{{#if (eq nav 'events')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
        <a href="/organizer/contestants" {{#if (eq nav 'contestants')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span>
          <span class="flex-1">Contestants</span>{{#if (eq nav 'contestants')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
        <a href="/organizer/categories" {{#if (eq nav 'categories')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg></span>
          <span class="flex-1">Categories</span>{{#if (eq nav 'categories')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
        <a href="/organizer/criteria" {{#if (eq nav 'criteria')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span>
          <span class="flex-1">Criteria &amp; scoring</span>{{#if (eq nav 'criteria')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
        <a href="/organizer/assignments" {{#if (eq nav 'assignments')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 20a6 6 0 0 1 12 0m3-12v6m-3-3h6"/></svg></span>
          <span class="flex-1">Judges &amp; tabulators</span>{{#if (eq nav 'assignments')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
      </div>
    </div>

    <div>
      <p class="mb-2 px-3 text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">Judging &amp; results</p>
      <div class="space-y-1">
        <a href="/organizer/progress" {{#if (eq nav 'progress')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17"/><path stroke-linecap="round" stroke-linejoin="round" d="m7 15 4-4 3 2 5-6"/></svg></span>
          <span class="flex-1">Judging progress</span>{{#if (eq nav 'progress')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
        <a href="/organizer/reports" {{#if (eq nav 'reports')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M14 3v5h5M9 13h6m-6 4h6"/></svg></span>
          <span class="flex-1">Reports &amp; summaries</span>{{#if (eq nav 'reports')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
        <a href="/organizer/publish" {{#if (eq nav 'publish')}}aria-current="page"{{/if}} class="group flex items-center gap-3 rounded-xl border px-3 py-2 text-[13px] font-medium transition">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg text-blue-100/70"><svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg></span>
          <span class="flex-1">Approve &amp; publish</span>{{#if (eq nav 'publish')}}<span class="h-1.5 w-1.5 rounded-full bg-fair-gold shadow-[0_0_8px_rgba(201,162,39,0.65)]"></span>{{/if}}
        </a>
      </div>
    </div>
  </nav>

  <div class="relative border-t border-blue-100 bg-[#eaf1f8] px-4 py-4">
    <div class="mb-3 px-2">
      <p class="truncate text-xs font-semibold text-slate-700">{{currentUser.email}}</p>
      <p class="mt-1 text-[10px] font-medium uppercase tracking-[0.12em] text-slate-400">Organizer account</p>
    </div>
    <a href="/logout" class="group flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-left text-sm font-semibold text-slate-700 shadow-sm transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-800">
      <span class="flex items-center gap-2.5"><svg class="h-4 w-4 text-slate-400 transition group-hover:text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5m5 5H3"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg>Sign out</span>
      <span class="text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-rose-600" aria-hidden="true">&rarr;</span>
    </a>
  </div>
</aside>
