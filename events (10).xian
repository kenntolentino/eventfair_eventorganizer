{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-amber-400/10 blur-3xl"></div>
  <div class="relative flex items-center gap-4">
    <span class="hidden h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl border border-white/15 bg-white/[0.08] text-amber-200 sm:flex"><svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 15 2 2 4-4"/></svg></span>
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-amber-300"></span>Assigned scope</span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Assigned events</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-blue-100/80">Only assigned events and their judging records are available to your tabulator account.</p>
    </div>
  </div>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:px-6">
    <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"/></svg></span><div><h2 class="font-bold text-slate-950">Your event assignments</h2><p class="mt-1 text-xs text-slate-500">Review score sheets, readiness, and tabulation actions for each event.</p></div></div>
    <a href="/tabulator/discrepancies" class="inline-flex items-center gap-1 self-start rounded-lg px-3 py-2 text-xs font-bold text-amber-800 transition hover:bg-amber-50 hover:text-amber-950 sm:self-auto">View discrepancies<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[1050px] text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500">
        <tr><th class="px-5 py-4 font-bold">Event</th><th class="px-5 py-4 font-bold">Phase</th><th class="px-5 py-4 font-bold">Participants</th><th class="px-5 py-4 font-bold">Scoring formula</th><th class="px-5 py-4 font-bold">Readiness</th><th class="px-5 py-4 text-right font-bold">Actions</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {{#each events}}
        <tr class="transition hover:bg-amber-50/30">
          <td class="px-5 py-4">
            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-amber-50 to-orange-100 text-amber-800 ring-1 ring-amber-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span>
              <div class="max-w-xs"><p class="font-semibold text-slate-900">{{name}}</p><p class="mt-1 text-xs text-slate-500">{{#if venue}}{{venue}}{{else}}Venue not announced{{/if}} <span class="mx-1 text-slate-300">·</span> {{#if startDate}}{{startDate}}{{else}}Date not set{{/if}}{{#if endDate}} – {{endDate}}{{/if}}</p>{{#if description}}<p class="mt-1 line-clamp-2 text-xs leading-5 text-slate-500">{{description}}</p>{{/if}}</div>
            </div>
          </td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold capitalize text-slate-700"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>{{status}}</span></td>
          <td class="px-5 py-4"><p class="font-semibold text-slate-800">{{contestantCount}} contestants</p><p class="mt-1 text-xs text-slate-500">{{judges}} assigned judges</p></td>
          <td class="px-5 py-4"><p class="max-w-[13rem] font-medium leading-5 text-slate-800">{{#if (eq scoringFormula 'average_weighted')}}Average of weighted judge scores{{else}}Sum of weighted judge scores{{/if}}</p><p class="mt-1 text-[10px] font-bold uppercase tracking-[0.1em] text-slate-400">Approved formula</p></td>
          <td class="px-5 py-4">
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold {{#if ready}}border-emerald-200 bg-emerald-50 text-emerald-800{{else}}border-amber-200 bg-amber-50 text-amber-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if ready}}bg-emerald-500{{else}}bg-amber-500{{/if}}"></span>{{#if ready}}Ready to tabulate{{else}}Review required{{/if}}</span>
            <p class="mt-2 text-xs font-semibold text-slate-700">{{completeSheets}} <span class="font-normal text-slate-400">/ {{expectedSheets}} sheets</span></p>
            <p class="mt-1 max-w-[16rem] text-[10px] leading-4 text-slate-500">{{incompleteContestants}} contestant(s) need review <span class="text-slate-300">·</span> {{openIssues}} open discrepancies <span class="text-slate-300">·</span> {{unassignedSheets}} unassigned sheets</p>
          </td>
          <td class="px-5 py-4">
            <div class="flex flex-wrap justify-end gap-2">
              <a href="/tabulator/submissions?eventId={{id}}" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-amber-200 hover:bg-amber-50 hover:text-amber-900"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg>Review sheets</a>
              <a href="/tabulator/computation?eventId={{id}}" class="inline-flex items-center gap-1.5 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-800"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>Open tabulation</a>
            </div>
          </td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="6"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><p class="mt-4 font-semibold text-slate-800">No assigned events</p><p class="mt-1 text-sm text-slate-500">Ask an event organizer to assign you before reviewing scores or generating results.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{> app-end}}
