{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-violet-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 xl:flex-row xl:items-end">
  <div class="max-w-2xl">
    <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-violet-300"></span>Private score sheets</span>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Score entry &amp; review</h1>
    <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Score each registered contestant using only the criteria that apply to their event category. Save drafts or submit a complete evaluation.</p>
  </div>
  {{#if selected}}
  <form method="GET" action="/judge/scoring" class="grid w-full gap-2 sm:grid-cols-2 xl:w-auto xl:min-w-[26rem]">
    <label class="sr-only" for="scoreEvent">Select assigned event</label>
    <select id="scoreEvent" name="eventId" class="w-full rounded-xl border border-white/15 bg-white/[0.08] px-3.5 py-2.5 text-sm text-white outline-none transition focus:border-violet-300 focus:ring-4 focus:ring-violet-300/10" onchange="this.form.elements['categoryId'].value='';this.form.submit()">{{#each events}}<option class="text-slate-900" value="{{id}}" {{#if (eq ../selected.id id)}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <label class="sr-only" for="scoreCategory">Filter contestants by category</label>
    <select id="scoreCategory" name="categoryId" class="w-full rounded-xl border border-white/15 bg-white/[0.08] px-3.5 py-2.5 text-sm text-white outline-none transition focus:border-violet-300 focus:ring-4 focus:ring-violet-300/10" onchange="this.form.submit()">
      {{#each categories}}<option class="text-slate-900" value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </form>
  {{/if}}
  </div>
</section>
{{#if selected}}
<section class="mb-6 overflow-hidden rounded-2xl border {{#if scoringOpen}}border-violet-200/80 bg-gradient-to-r from-violet-50 via-white to-blue-50{{else}}border-amber-200/80 bg-gradient-to-r from-amber-50 via-white to-orange-50{{/if}} shadow-sm">
  <div class="p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-start gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl {{#if scoringOpen}}bg-violet-100 text-violet-800 ring-1 ring-violet-200{{else}}bg-amber-100 text-amber-800 ring-1 ring-amber-200{{/if}}"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><div><p class="text-[10px] font-bold uppercase tracking-[0.14em] {{#if scoringOpen}}text-violet-700{{else}}text-amber-800{{/if}}">Selected event</p><h2 class="mt-1 text-lg font-bold text-slate-950">{{selected.name}}</h2><p class="mt-1 text-sm text-slate-600">{{#if selected.venue}}{{selected.venue}}{{else}}Venue not announced{{/if}} <span class="mx-1 text-slate-300">·</span> {{#if selected.startDate}}{{selected.startDate}}{{else}}Date not set{{/if}}</p></div></div>
    <span class="inline-flex items-center gap-1.5 rounded-full border bg-white/80 px-2.5 py-1 text-xs font-semibold capitalize {{#if scoringOpen}}border-violet-200 text-violet-800{{else}}border-amber-200 text-amber-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if scoringOpen}}bg-violet-500{{else}}bg-amber-500{{/if}}"></span>{{selected.status}}</span>
  </div>
  {{#if selected.evaluationInstructions}}<p class="mt-4 border-t border-black/5 pt-4 text-sm leading-6 text-slate-700"><span class="font-semibold">Instructions:</span> {{selected.evaluationInstructions}}</p>{{/if}}
  {{#if scoringOpen}}
  <p class="mt-3 inline-flex items-center gap-2 text-xs font-medium leading-5 text-violet-900"><svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11v5m0-8h.01M5 20h14a2 2 0 0 0 1.7-3L13.7 4a2 2 0 0 0-3.4 0L3.3 17A2 2 0 0 0 5 20Z"/></svg>Scoring is open. Your individual entries are confidential. Check every score and remark before submitting.</p>
  {{else}}
  <p class="mt-3 inline-flex items-start gap-2 text-sm leading-6 text-amber-900"><svg class="mt-0.5 h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 10V7a4 4 0 1 1 8 0v3"/></svg>Score entry is closed outside the ongoing and judging phases. Existing sheets remain available for review, but cannot be changed.</p>
  {{/if}}
  </div>
</section>
<section class="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Scoring settings">
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-violet-500"></div><p class="text-xs font-semibold text-slate-500">Contestants shown</p><p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">{{contestants.length}}</p><p class="mt-1 text-[10px] font-bold uppercase tracking-[0.12em] text-violet-700">Current selection</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div><p class="text-xs font-semibold text-slate-500">Scoring formula</p><p class="mt-2 text-base font-bold text-slate-900">{{#if (eq selected.scoringFormula 'average_weighted')}}Average weighted{{else}}Sum weighted{{/if}}</p><p class="mt-1 text-[10px] font-bold uppercase tracking-[0.12em] text-blue-700">Event rubric</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 {{#if selected.allowScoreRevision}}bg-amber-500{{else}}bg-slate-400{{/if}}"></div><p class="text-xs font-semibold text-slate-500">Revision policy</p><p class="mt-2 text-sm font-bold {{#if selected.allowScoreRevision}}text-amber-800{{else}}text-slate-900{{/if}}">{{#if selected.allowScoreRevision}}Revisions permitted while judging is open{{else}}Submitted scores are locked{{/if}}</p><p class="mt-1 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Submission rules</p></article>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span><div><h2 class="text-base font-bold text-slate-950">Contestant score sheets</h2><p class="mt-0.5 text-xs text-slate-500">Open a contestant to enter or review your confidential evaluation.</p></div></div><span class="inline-flex items-center gap-2 rounded-full border border-violet-100 bg-violet-50 px-3 py-1.5 text-xs font-semibold text-violet-800"><span class="h-1.5 w-1.5 rounded-full bg-violet-600"></span>{{contestants.length}} contestants</span></div>
  <div class="overflow-x-auto">
    <table class="min-w-[760px] w-full text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Contestant</th><th class="px-5 py-4 font-bold">Category &amp; rubric</th><th class="px-5 py-4 font-bold">Score sheet</th><th class="px-5 py-4 text-right font-bold">Evaluation</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
  {{#each contestants}}
        <tr class="transition hover:bg-violet-50/30">
          <td class="px-5 py-4"><div class="flex items-center gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-violet-50 to-blue-100 text-xs font-bold text-violet-800 ring-1 ring-violet-100">{{contestantNumber}}</span><div class="min-w-0"><p class="font-semibold text-slate-900">{{fullName}}</p>{{#if organization}}<p class="mt-1 max-w-xs truncate text-xs text-slate-500">{{organization}}</p>{{/if}}</div></div></td>
          <td class="px-5 py-4"><p class="font-medium text-slate-800">{{#if Category}}{{Category.name}}{{else}}General category{{/if}}</p><p class="mt-1 text-xs text-slate-500">{{criteria.length}} applicable criteria</p>{{#unless rubricBalanced}}<span class="mt-2 inline-flex items-center gap-1.5 text-[10px] font-semibold text-amber-700"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>Rubric needs correction</span>{{/unless}}</td>
          <td class="px-5 py-4">
        {{#if sheet}}
        <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold capitalize {{#if (eq sheet.status 'submitted')}}border-emerald-200 bg-emerald-50 text-emerald-800{{else}}border-amber-200 bg-amber-50 text-amber-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq sheet.status 'submitted')}}bg-emerald-500{{else}}bg-amber-500{{/if}}"></span>{{sheet.status}}</span>
        {{#if sheet.submittedAt}}<p class="mt-1.5 text-[10px] text-slate-400">{{date sheet.submittedAt}}</p>{{/if}}
        {{else if ../scoringOpen}}
        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-600"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>Not started</span>
        {{else}}
        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-500"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>No score sheet</span>
        {{/if}}
          </td>
          <td class="whitespace-nowrap px-5 py-4 text-right">
        {{#if sheet}}
        <button type="button" onclick="openModal('score-{{id}}')" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-bold text-violet-800 transition hover:bg-violet-50">{{#if canEdit}}Review &amp; edit{{else}}Review scores{{/if}}<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
        {{else if ../scoringOpen}}
        <button type="button" onclick="openModal('score-{{id}}')" class="inline-flex items-center gap-1.5 rounded-xl bg-violet-800 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-violet-900">Evaluate<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
        {{else}}
        <span class="text-xs text-slate-400">Score entry closed</span>
        {{/if}}
          </td>
        </tr>
        {{#unless rubricBalanced}}
        <tr class="bg-amber-50/70"><td colspan="4" class="px-5 py-2.5"><p class="inline-flex items-center gap-2 text-xs leading-5 text-amber-900"><svg class="h-4 w-4 flex-shrink-0 text-amber-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 3h.01"/></svg>The applicable criteria do not total 100%. You can save a draft, but submission requires the organizer to correct the rubric.</p></td></tr>
        {{/unless}}
  {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="4"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span><p class="mt-4 font-semibold text-slate-800">No registered contestants</p><p class="mt-1 text-sm text-slate-500">Registered contestants for this event will appear here for evaluation.</p></td></tr>
  {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{#each contestants}}
<div id="score-{{id}}" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="scoreTitle-{{id}}">
  <div class="max-h-[92vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
    <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
      <div><p class="text-xs font-semibold uppercase tracking-wide text-violet-700">Contestant {{contestantNumber}}</p><h2 id="scoreTitle-{{id}}" class="mt-1 text-xl font-semibold text-slate-950">{{fullName}}</h2><p class="mt-1 text-sm text-slate-500">{{#if Category}}{{Category.name}}{{else}}General category{{/if}} · {{../selected.name}}</p></div>
      <button type="button" onclick="closeModal('score-{{id}}')" aria-label="Close score sheet" class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-600 hover:bg-slate-50">Close</button>
    </div>
    {{#if canEdit}}
    <form method="POST" action="/judge/scoring" class="mt-5">
      <input type="hidden" name="eventId" value="{{../selected.id}}" />
      <input type="hidden" name="contestantId" value="{{id}}" />
      {{#if sheet.status}}<div class="mb-4 rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600">Review the existing values, update as needed, then submit the complete score sheet.</div>{{/if}}
      {{#each criteria}}
      <div class="mb-4 rounded-xl border border-slate-200 p-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2"><label for="score-{{../id}}-{{id}}" class="font-semibold text-slate-900">{{name}}</label><span class="text-xs font-semibold text-violet-800">{{weightPercentage}}% · {{minScore}}–{{maxScore}}</span></div>
        {{#if description}}<p class="mt-1 text-sm leading-5 text-slate-600">{{description}}</p>{{/if}}
        <input id="score-{{../id}}-{{id}}" type="number" inputmode="decimal" step="0.01" name="score_{{id}}" min="{{minScore}}" max="{{maxScore}}" value="{{scoreVal ../sheet.scoreMap id}}" required class="mt-3 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20" placeholder="Enter a score from {{minScore}} to {{maxScore}}" />
      </div>
      {{else}}
      <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">No criteria are configured for this contestant. Contact the event organizer before scoring.</p>
      {{/each}}
      <label for="remarks-{{id}}" class="mb-1 block text-sm font-semibold text-slate-700">Confidential remarks <span class="font-normal text-slate-400">(optional)</span></label>
      <textarea id="remarks-{{id}}" name="remarks" rows="3" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20" placeholder="Add notes relevant to this evaluation">{{sheet.remarks}}</textarea>
      <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-4">
        <button type="button" onclick="closeModal('score-{{id}}')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
        {{#if criteria}}<button type="submit" name="action" value="draft" formnovalidate class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Save draft</button>{{#if rubricBalanced}}<button type="submit" name="action" value="submit" class="rounded-xl bg-violet-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-violet-900">Review &amp; submit</button>{{else}}<button type="button" disabled title="Contact the organizer to correct the rubric weights" class="cursor-not-allowed rounded-xl bg-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-600">Rubric needs correction</button>{{/if}}{{/if}}
      </div>
    </form>
    {{else}}
    <div class="mt-5">
      {{#if sheet.status}}<div class="mb-4 rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600">This score sheet is read-only. {{#if (eq sheet.status 'submitted')}}Submitted {{#if sheet.submittedAt}}{{date sheet.submittedAt}}{{/if}}.{{else}}Score entry is currently closed.{{/if}}</div>{{else}}<div class="mb-4 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900">Score entry is currently closed for this event.{{/if}}
      {{#each criteria}}
      <div class="mb-4 rounded-xl border border-slate-200 p-4"><div class="flex flex-wrap items-baseline justify-between gap-2"><p class="font-semibold text-slate-900">{{name}}</p><span class="text-xs font-semibold text-violet-800">{{weightPercentage}}% · {{minScore}}–{{maxScore}}</span></div>{{#if description}}<p class="mt-1 text-sm leading-5 text-slate-600">{{description}}</p>{{/if}}<p class="mt-3 rounded-lg bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-slate-800">{{#if (eq (scoreVal ../sheet.scoreMap id) '')}}Not scored{{else}}{{scoreVal ../sheet.scoreMap id}}{{/if}}</p></div>
      {{else}}<p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">No criteria are configured for this contestant.</p>{{/each}}
      {{#if sheet.remarks}}<p class="mb-5 text-sm leading-6 text-slate-600"><span class="font-semibold text-slate-800">Confidential remarks:</span> {{sheet.remarks}}</p>{{/if}}
      <div class="flex justify-end border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('score-{{id}}')" class="rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">Close review</button></div>
    </div>
    {{/if}}
  </div>
</div>
{{/each}}
{{else}}
<div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center"><h2 class="font-semibold text-slate-800">No assigned events</h2><p class="mt-1 text-sm text-slate-500">You need an active event assignment before score entry is available.</p><a href="/judge/events" class="mt-4 inline-block text-sm font-semibold text-violet-800">View assigned events</a></div>
{{/if}}
{{> app-end}}
