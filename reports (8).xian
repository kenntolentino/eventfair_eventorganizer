{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Review &amp; documentation</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Reports &amp; summaries</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Review tabulator documentation and verified competition rankings before authorizing publication.</p>
    </div>
    <a href="/organizer/publish" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">
      Review publication
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
    </a>
  </div>
</section>

<section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Reports summary">
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div>
    <div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Tabulation reports</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.reports}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M14 3v5h5M9 13h6m-6 4h6"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">Official documentation</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></div>
    <div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Result records</p><p class="mt-3 text-3xl font-bold tracking-tight text-emerald-700">{{stats.results}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17"/><path stroke-linecap="round" stroke-linejoin="round" d="m7 15 4-4 3 2 5-6"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Verified rankings</p>
  </article>
</section>

<section class="mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700 ring-1 ring-indigo-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18l-7 8v5l-4 2v-7L3 5Z"/></svg></span>
    <div><h2 class="text-base font-bold text-slate-950">Filter reports</h2><p class="mt-0.5 text-xs text-slate-500 sm:text-sm">Choose a competition to review its reports and rankings.</p></div>
  </div>
  <form method="GET" action="/organizer/reports" class="grid gap-3 bg-slate-50/60 p-4 sm:grid-cols-[minmax(240px,1fr)_auto] sm:items-end sm:p-5">
    <div><label class="mb-1.5 block text-xs font-semibold text-slate-600" for="reportEvent">Review event</label><select id="reportEvent" name="eventId" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"><option value="">All events</option>{{#each events}}<option value="{{id}}" {{#if (eq ../filters.eventId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
    <div class="flex gap-2"><button class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65] sm:flex-none"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18l-7 8v5l-4 2v-7L3 5Z"/></svg>Apply</button><a href="/organizer/reports" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 sm:flex-none">Clear</a></div>
  </form>
</section>

<section class="grid grid-cols-1 items-start gap-6 2xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
  <article class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
    <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
      <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M14 3v5h5M9 13h6m-6 4h6"/></svg></span>
      <div><h2 class="text-base font-bold text-slate-950">Tabulation reports</h2><p class="mt-0.5 text-xs text-slate-500">Summary records provided by assigned tabulators.</p></div>
    </div>
    <div class="divide-y divide-slate-100">
      {{#each reports}}
      <article class="px-5 py-5 transition hover:bg-blue-50/30 sm:px-6">
        <div class="flex items-start gap-3">
          <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M14 3v5h5M9 13h6m-6 4h6"/></svg></span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1"><h3 class="font-semibold text-slate-900">{{title}}</h3><time class="whitespace-nowrap text-[11px] font-medium text-slate-400">{{date createdAt}}</time></div>
            <p class="mt-1.5 text-xs font-semibold text-blue-800">{{#if Event}}{{Event.name}}{{else}}Event{{/if}}{{#if author}} <span class="font-normal text-slate-400">·</span> <span class="font-medium text-slate-500">Prepared by {{author.name}}</span>{{/if}}</p>
            <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-600">{{#if summary}}{{summary}}{{else}}No summary provided.{{/if}}</p>
          </div>
        </div>
      </article>
      {{else}}
      <div class="px-5 py-12 text-center sm:px-6"><span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/></svg></span><p class="mt-3 font-semibold text-slate-800">No tabulation reports</p><p class="mt-1 text-sm text-slate-500">There are no reports for this event selection.</p></div>
      {{/each}}
    </div>
  </article>

  <article class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
      <div class="flex items-center gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m12 3 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7L12 3Z"/></svg></span><div><h2 class="text-base font-bold text-slate-950">Competition rankings</h2><p class="mt-0.5 text-xs text-slate-500">Current verified or published tabulation results.</p></div></div>
      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-emerald-100 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-800"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{{stats.results}} results</span>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-[640px] w-full text-left text-sm">
        <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-4 py-3.5 font-bold">Rank</th><th class="px-4 py-3.5 font-bold">Contestant</th><th class="px-4 py-3.5 font-bold">Event</th><th class="px-4 py-3.5 text-right font-bold">Average</th><th class="px-4 py-3.5 font-bold">Status</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          {{#each results}}
          <tr class="transition hover:bg-emerald-50/30">
            <td class="px-4 py-3.5"><span class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 px-2 text-xs font-bold tabular-nums text-slate-700">#{{rank}}</span></td>
            <td class="px-4 py-3.5"><p class="font-semibold text-slate-900">{{contestantName}}</p></td>
            <td class="px-4 py-3.5 text-xs text-slate-600">{{#if Event}}{{Event.name}}{{else}}—{{/if}}</td>
            <td class="px-4 py-3.5 text-right"><span class="font-bold tabular-nums text-slate-900">{{averageScore}}</span></td>
            <td class="px-4 py-3.5"><span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-semibold capitalize text-slate-700"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>{{status}}</span></td>
          </tr>
          {{else}}
          <tr><td class="px-4 py-12 text-center" colspan="5"><span class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m12 3 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7L12 3Z"/></svg></span><p class="mt-3 font-semibold text-slate-800">No tabulated results</p><p class="mt-1 text-xs text-slate-500">Rankings will appear here when available.</p></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </article>
</section>
<div class="mt-6 flex justify-end"><a href="/organizer/publish" class="inline-flex items-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65]">Review publication workflow <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
{{> app-end}}
