{{> head}}
<body class="bg-slate-100 min-h-screen flex items-center justify-center">
  <div class="bg-white w-full max-w-md p-8 rounded-2xl shadow text-center">
    <h2 class="text-2xl font-semibold">Password assistance</h2>
    <p class="mt-3 text-slate-500">Contact your system administrator to reactivate or reset an account. Password self-service is not enabled.</p>
    <a href="/login" class="inline-block mt-6 text-fair-700">Back to sign in</a>
  </div>
</body>
</html>
