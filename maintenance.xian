{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-fair-900 to-fair-800 px-6 py-7 text-white shadow-xl shadow-slate-900/10 sm:px-8 sm:py-9">
  <div class="pointer-events-none absolute -right-10 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -right-2 -top-12 h-48 w-48 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -bottom-28 right-40 h-56 w-56 rounded-full bg-fair-500/20 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        PLATFORM OPERATIONS
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Health &amp; maintenance</h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300 sm:text-base">Monitor application availability, database connectivity, and process uptime from a single operational overview.</p>
    </div>
    <a href="/admin/maintenance" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/15">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7v5h-5"/><path stroke-linecap="round" stroke-linejoin="round" d="M20 12a8 8 0 1 1-2.3-5.7L20 9"/></svg>
      Run health check again
    </a>
  </div>
</section>

<section class="mb-7 grid grid-cols-1 gap-4 md:grid-cols-3" aria-label="System health">
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-sm font-semibold text-slate-500">Application</p>
        <div class="mt-4 flex items-center gap-2.5">
          <span class="relative flex h-3 w-3" aria-hidden="true"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-30"></span><span class="relative inline-flex h-3 w-3 rounded-full bg-emerald-500"></span></span>
          <p class="text-xl font-bold text-slate-950">Running</p>
        </div>
      </div>
      <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="13" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M7 9h3m-3 4h7"/></svg></span>
    </div>
    <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-3">
      <p class="text-xs text-slate-500">Runtime environment</p>
      <span class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">Node.js {{nodeVersion}}</span>
    </div>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-sm font-semibold text-slate-500">Database connection</p>
        <div class="mt-4 flex items-center gap-2.5">
          <span class="h-3 w-3 rounded-full {{#if databaseError}}bg-rose-500{{else}}bg-emerald-500{{/if}}" aria-hidden="true"></span>
          <p class="text-xl font-bold {{#if databaseError}}text-rose-700{{else}}text-emerald-700{{/if}}">{{databaseStatus}}</p>
        </div>
      </div>
      <span class="flex h-11 w-11 items-center justify-center rounded-xl {{#if databaseError}}bg-rose-50 text-rose-700{{else}}bg-blue-50 text-blue-700{{/if}}" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5" rx="8" ry="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg></span>
    </div>
    <div class="mt-5 border-t border-slate-100 pt-3">
      {{#if databaseError}}<p class="break-words text-xs leading-5 text-rose-700">{{databaseError}}</p>{{else}}<p class="flex items-center gap-1.5 text-xs text-slate-500"><svg class="h-3.5 w-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg>Database authentication check passed.</p>{{/if}}
    </div>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-sm font-semibold text-slate-500">Process uptime</p>
        <p class="mt-4 text-3xl font-bold tracking-tight text-slate-950">{{uptimeHours}} <span class="text-base font-semibold text-slate-500">hrs</span></p>
      </div>
      <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg></span>
    </div>
    <div class="mt-5 border-t border-slate-100 pt-3 text-xs text-slate-500">Since the application process started</div>
  </article>
</section>

<section class="mb-6 flex flex-col justify-between gap-4 rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:px-6">
  <div class="flex items-center gap-4">
    <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18"/></svg></span>
    <div>
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500">Last health check</p>
      <p class="mt-1 font-semibold text-slate-900">{{date checkedAt}}</p>
    </div>
  </div>
  <a href="/admin/reports" class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-fair-700 transition hover:bg-blue-50">Open data reports <span aria-hidden="true">&rarr;</span></a>
</section>

<section class="relative overflow-hidden rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 via-amber-50 to-white p-5 shadow-sm sm:p-6">
  <div class="pointer-events-none absolute -right-8 -top-12 h-40 w-40 rounded-full border border-amber-200/70"></div>
  <div class="relative flex items-start gap-4">
    <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-800" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg></span>
    <div class="max-w-4xl">
      <span class="inline-flex rounded-full border border-amber-200 bg-white/70 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-amber-800">Action recommended</span>
      <h2 class="mt-2 text-base font-bold text-amber-950">Backup and restore are not configured</h2>
      <p class="mt-2 text-sm leading-6 text-amber-900">This installation does not currently have an automated database backup or restore workflow. No backup has been created by this page. Configure and verify a protected database backup process in the deployment environment before relying on recovery procedures. The CSV reports are summaries only and are not restorable database backups.</p>
    </div>
  </div>
</section>
{{> app-end}}
