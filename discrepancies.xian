{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-rose-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
    <div class="max-w-2xl"><span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-amber-300"></span>Quality control</span><h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Discrepancy register</h1><p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Record incomplete or inconsistent scoring records and track follow-up through resolution before tabulation.</p></div>
    <button type="button" onclick="openModal('createModal')" class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-400 px-4 py-2.5 text-sm font-bold text-slate-950 shadow-sm transition hover:bg-amber-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/></svg>Report discrepancy</button>
  </div>
</section>
<section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Discrepancy overview">
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div><div class="flex items-start justify-between"><div><p class="text-xs font-semibold text-slate-500">Records shown</p><p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">{{stats.total}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-blue-700">Current filter</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-rose-500"></div><div class="flex items-start justify-between"><div><p class="text-xs font-semibold text-slate-500">Open</p><p class="mt-2 text-2xl font-bold tracking-tight text-rose-800">{{stats.open}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-50 text-rose-700 ring-1 ring-rose-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" d="M12 9v4m0 3h.01"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-rose-700">Requires attention</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-amber-500"></div><div class="flex items-start justify-between"><div><p class="text-xs font-semibold text-slate-500">Under review</p><p class="mt-2 text-2xl font-bold tracking-tight text-amber-800">{{stats.underReview}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-amber-700">In progress</p></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></div><div class="flex items-start justify-between"><div><p class="text-xs font-semibold text-slate-500">Resolved</p><p class="mt-2 text-2xl font-bold tracking-tight text-emerald-800">{{stats.resolved}}</p></div><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg></span></div><p class="mt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-emerald-700">Closed audit records</p></article>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 sm:px-6"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-rose-700 ring-1 ring-rose-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" d="M12 9v4m0 3h.01"/></svg></span><div><h2 class="font-bold text-slate-950">Issue audit log</h2><p class="mt-1 text-xs text-slate-500">Review reported concerns, status, ownership, and resolution history.</p></div></div>
  <form method="GET" action="/tabulator/discrepancies" class="grid gap-3 border-b border-slate-100 bg-slate-50/60 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end sm:p-5"><div><label class="mb-1.5 block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500" for="discrepancyStatus">Filter by status</label><select id="discrepancyStatus" name="status" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-amber-500 focus:ring-4 focus:ring-amber-500/10"><option value="">All statuses</option><option value="open" {{#if (eq filters.status 'open')}}selected{{/if}}>Open</option><option value="under_review" {{#if (eq filters.status 'under_review')}}selected{{/if}}>Under review</option><option value="resolved" {{#if (eq filters.status 'resolved')}}selected{{/if}}>Resolved</option></select></div><div class="flex gap-2"><button class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 sm:flex-none"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16l-6.5 7.5V19l-3 1v-7.5L4 5Z"/></svg>Filter</button><a href="/tabulator/discrepancies" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 sm:flex-none">Reset</a></div></form>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[1100px] text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Issue</th><th class="px-5 py-4 font-bold">Event / contestant</th><th class="px-5 py-4 font-bold">Reported by</th><th class="px-5 py-4 font-bold">Status</th><th class="px-5 py-4 text-right font-bold">Actions</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each discrepancies}}
        <tr class="align-top transition hover:bg-rose-50/20">
          <td class="max-w-md px-5 py-4"><div class="flex items-start gap-3"><span class="mt-0.5 flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl {{#if (eq status 'resolved')}}bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100{{else if (eq status 'under_review')}}bg-amber-50 text-amber-700 ring-1 ring-amber-100{{else}}bg-rose-50 text-rose-700 ring-1 ring-rose-100{{/if}}"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" d="M12 9v4m0 3h.01"/></svg></span><div><p class="font-semibold text-slate-900">{{title}}</p><p class="mt-1 text-xs leading-5 text-slate-600">{{#if description}}{{description}}{{else}}No additional description.{{/if}}</p>{{#if resolutionNotes}}<div class="mt-2 rounded-lg border border-emerald-100 bg-emerald-50 px-3 py-2 text-xs leading-5 text-emerald-900"><span class="font-semibold">Resolution:</span> {{resolutionNotes}}</div>{{/if}}</div></div></td>
          <td class="px-5 py-4"><p class="font-semibold text-slate-800">{{#if Event}}{{Event.name}}{{else}}Event unavailable{{/if}}</p><p class="mt-1 text-xs text-slate-500">{{#if contestantName}}{{contestantName}}{{else}}Event-level issue{{/if}}</p></td>
          <td class="px-5 py-4"><p class="text-xs font-semibold text-slate-700">{{#if reporter}}{{reporter.name}}{{else}}—{{/if}}</p><p class="mt-1 text-[10px] text-slate-400">{{date createdAt}}</p></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold {{#if (eq status 'resolved')}}border-emerald-200 bg-emerald-50 text-emerald-800{{else if (eq status 'under_review')}}border-amber-200 bg-amber-50 text-amber-800{{else}}border-rose-200 bg-rose-50 text-rose-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq status 'resolved')}}bg-emerald-500{{else if (eq status 'under_review')}}bg-amber-500{{else}}bg-rose-500{{/if}}"></span>{{#if (eq status 'under_review')}}Under review{{else}}{{status}}{{/if}}</span></td>
          <td class="whitespace-nowrap px-5 py-4 text-right">{{#if (eq status 'resolved')}}<span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 10V7a4 4 0 1 1 8 0v3"/></svg>Audit record · read-only</span>{{else}}<div class="inline-flex items-center justify-end gap-1"><button type="button" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-amber-800 transition hover:bg-amber-50" onclick="openEdit('editModal','editForm','{{jsonAttr this}}','/tabulator/discrepancies/{{id}}')">Update</button><button type="button" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-50" onclick="openDelete('deleteModal','deleteForm','/tabulator/discrepancies/{{id}}/delete','{{jsonAttr title}}')">Delete</button></div>{{/if}}</td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="5"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 text-rose-700 ring-1 ring-rose-100"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" d="M12 9v4m0 3h.01"/></svg></span><p class="mt-4 font-semibold text-slate-700">No discrepancies found</p><p class="mt-1 text-sm text-slate-500">Reported issues from your assigned events will appear here.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
<div id="createModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="createDiscrepancyTitle"><div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl"><div class="mb-5 flex items-start gap-3 border-b border-slate-100 pb-4"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-rose-50 text-rose-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 2.8 20h18.4L12 3Z"/><path stroke-linecap="round" d="M12 9v4m0 3h.01"/></svg></span><div><h2 id="createDiscrepancyTitle" class="text-xl font-bold text-slate-950">Report a scoring discrepancy</h2><p class="mt-1 text-sm text-slate-500">Record the event and scoring issue that needs authorized review.</p></div></div><form method="POST" action="/tabulator/discrepancies">{{> discrepancy-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('createModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">Record issue</button></div></form></div></div>
<div id="editModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="editDiscrepancyTitle"><div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl"><div class="mb-5 flex items-start gap-3 border-b border-slate-100 pb-4"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-700"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></span><div><h2 id="editDiscrepancyTitle" class="text-xl font-bold text-slate-950">Update discrepancy</h2><p class="mt-1 text-sm text-slate-500">Record review progress and add resolution notes before closing the issue.</p></div></div><form id="editForm" method="POST">{{> discrepancy-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('editModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">Save update</button></div></form></div></div>
{{> delete-modal}}
{{> app-end}}
