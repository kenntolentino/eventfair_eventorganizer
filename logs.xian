{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-fair-900 to-fair-800 px-6 py-7 text-white shadow-xl shadow-slate-900/10 sm:px-8 sm:py-9">
  <div class="pointer-events-none absolute -right-10 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -right-2 -top-12 h-48 w-48 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -bottom-28 right-40 h-56 w-56 rounded-full bg-fair-500/20 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
    <div class="max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        ACCOUNTABILITY &amp; OVERSIGHT
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Activity &amp; audit log</h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300 sm:text-base">Follow recorded user and system activity to support accountability, maintain visibility, and review operational events.</p>
    </div>
    <form method="GET" action="/admin/logs" class="flex w-full flex-col gap-2 sm:flex-row lg:w-auto">
      <label class="relative block min-w-0 flex-1 sm:w-80">
        <span class="sr-only">Search activity records</span>
        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-4-4"/></svg>
        <input id="activitySearch" name="q" value="{{q}}" placeholder="Search action, module, or details" class="w-full rounded-xl border border-white/15 bg-white/10 py-2.5 pl-10 pr-3.5 text-sm text-white outline-none transition placeholder:text-slate-300 focus:border-white/40 focus:bg-white/15 focus:ring-4 focus:ring-white/10" />
      </label>
      <div class="flex gap-2">
        <button class="rounded-xl bg-fair-gold px-4 py-2.5 text-sm font-bold text-slate-950 transition hover:bg-amber-300">Search records</button>
        {{#if q}}<a href="/admin/logs" class="rounded-xl border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/15">Clear</a>{{/if}}
      </div>
    </form>
  </div>
</section>

<section class="mb-5 flex flex-col justify-between gap-4 rounded-2xl border border-blue-200/80 bg-gradient-to-r from-blue-50 to-white p-4 shadow-sm sm:flex-row sm:items-center sm:px-5">
  <div class="flex items-start gap-3">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 4.5 7v5c0 4.8 3.2 7.7 7.5 9 4.3-1.3 7.5-4.2 7.5-9V7L12 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg></span>
    <div>
      <p class="text-sm font-bold text-blue-950">{{#if q}}Search results{{else}}Recent system activity{{/if}}</p>
      <p class="mt-1 text-xs leading-5 text-blue-800">Showing up to 200 newest matching records. Activity records are maintained for audit purposes.</p>
    </div>
  </div>
  <span class="inline-flex w-fit items-center gap-2 rounded-full border border-blue-100 bg-white px-3 py-1.5 text-[10px] font-bold tracking-[0.12em] text-blue-800"><span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>AUDIT LOG</span>
</section>

<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-fair-700">Activity stream</p><h2 class="mt-1 text-base font-bold text-slate-950">Recorded actions</h2></div>
    <span class="text-xs text-slate-500">Newest entries first</span>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-[1050px] w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50/80 text-[10px] uppercase tracking-[0.1em] text-slate-500">
        <tr><th scope="col" class="w-[15%] px-5 py-3.5 font-bold sm:px-6">When</th><th scope="col" class="w-[18%] px-5 py-3.5 font-bold sm:px-6">Account</th><th scope="col" class="w-[15%] px-5 py-3.5 font-bold sm:px-6">Action</th><th scope="col" class="w-[12%] px-5 py-3.5 font-bold sm:px-6">Module</th><th scope="col" class="w-[27%] px-5 py-3.5 font-bold sm:px-6">Details</th><th scope="col" class="w-[13%] px-5 py-3.5 font-bold sm:px-6">IP address</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {{#each logs}}
        <tr class="align-top transition-colors hover:bg-blue-50/30">
          <td class="whitespace-nowrap px-5 py-4 sm:px-6"><div class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg><span class="text-xs leading-5 text-slate-600">{{date createdAt}}</span></div></td>
          <td class="px-5 py-4 sm:px-6">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-blue-50 to-indigo-100 text-blue-700" aria-hidden="true"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.25"/><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg></span>
              <div class="min-w-0"><p class="truncate font-semibold text-slate-800">{{#if actor}}{{actor.name}}{{else}}System{{/if}}</p>{{#if actor.email}}<p class="mt-0.5 truncate text-xs text-slate-500">{{actor.email}}</p>{{/if}}</div>
            </div>
          </td>
          <td class="px-5 py-4 font-semibold text-slate-800 sm:px-6"><span class="inline-flex rounded-lg bg-slate-100 px-2.5 py-1 text-xs">{{action}}</span></td>
          <td class="px-5 py-4 sm:px-6"><span class="inline-flex rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700">{{module}}</span></td>
          <td class="max-w-md break-words px-5 py-4 leading-5 text-slate-600 sm:px-6">{{#if details}}{{details}}{{else}}<span class="text-slate-400">No additional details</span>{{/if}}</td>
          <td class="whitespace-nowrap px-5 py-4 sm:px-6"><span class="inline-flex rounded-md bg-slate-50 px-2 py-1 font-mono text-xs text-slate-500">{{#if ipAddress}}{{ipAddress}}{{else}}—{{/if}}</span></td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-14 text-center" colspan="6"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a7.9 7.9 0 0 0 0-2l1.4-1.1-1.4-2.4-1.7.6a8 8 0 0 0-1.7-1L15.7 7h-2.8l-.3 2.1a8 8 0 0 0-1.7 1l-1.7-.6-1.4 2.4L9.2 13a7.9 7.9 0 0 0 0 2l-1.4 1.1 1.4 2.4 1.7-.6a8 8 0 0 0 1.7 1l.3 2.1h2.8l.3-2.1a8 8 0 0 0 1.7-1l1.7.6 1.4-2.4L19.4 15Z"/></svg></span><p class="mt-3 font-semibold text-slate-700">No activity records found</p><p class="mt-1 text-sm text-slate-500">Try another search phrase or clear the search filter.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  <div class="flex items-center gap-2 border-t border-slate-100 bg-slate-50/50 px-5 py-3 text-xs text-slate-500 sm:px-6"><svg class="h-4 w-4 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 11v5m0-8h.01"/></svg>Audit records are preserved for operational review.</div>
</section>
{{> app-end}}
