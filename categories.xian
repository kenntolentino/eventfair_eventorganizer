{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Competition structure</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Categories</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Organize competition divisions and keep contestant and judging criteria records aligned.</p>
    </div>
    <button type="button" onclick="openModal('createModal')" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/></svg>
      Add category
    </button>
  </div>
</section>
<section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Category summary">
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div>
    <div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Categories in workspace</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.total}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">All categories</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-violet-500"></div>
    <div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Matching categories</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.shown}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-violet-700">Current filter results</p>
  </article>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <div><h2 class="text-base font-bold text-slate-950">Category directory</h2><p class="mt-0.5 text-xs text-slate-500 sm:text-sm">Manage competition divisions and display sequence.</p></div>
    <span class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-800"><span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>{{stats.shown}} matching</span>
  </div>
  <form method="GET" action="/organizer/categories" class="grid gap-3 border-b border-slate-100 bg-slate-50/60 p-4 sm:p-5 sm:grid-cols-[minmax(240px,1fr)_240px_auto] sm:items-end">
    <label class="sr-only" for="categorySearch">Search categories</label>
    <div class="relative">
      <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/></svg>
      <input id="categorySearch" name="q" value="{{filters.q}}" placeholder="Search category name" class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>
    <label class="sr-only" for="categoryEvent">Filter by event</label>
    <select id="categoryEvent" name="eventId" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"><option value="">All events</option>{{#each events}}<option value="{{id}}" {{#if (eq ../filters.eventId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <div class="flex gap-2"><button class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65] sm:flex-none"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16l-6.5 7.5v5L10.5 19v-6.5L4 5Z"/></svg>Filter</button><a href="/organizer/categories" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 sm:flex-none">Reset</a></div>
  </form>
  <div class="overflow-x-auto">
    <table class="min-w-[700px] w-full text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.14em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Category</th><th class="px-5 py-4 font-bold">Event</th><th class="px-5 py-4 font-bold">Display order</th><th class="px-5 py-4 text-right font-bold">Actions</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each categories}}
        <tr class="transition hover:bg-blue-50/40">
          <td class="px-5 py-4"><div class="flex items-start gap-3"><span class="mt-0.5 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-50 to-indigo-100 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg></span><div class="min-w-0"><p class="font-semibold text-slate-900">{{name}}</p><p class="mt-1 max-w-md text-xs leading-5 text-slate-500">{{#if description}}{{description}}{{else}}No description{{/if}}</p></div></div></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-2 font-medium text-slate-700"><span class="h-2 w-2 rounded-full bg-blue-500"></span>{{#if Event}}{{Event.name}}{{else}}—{{/if}}</span></td>
          <td class="px-5 py-4"><span class="inline-flex min-w-9 justify-center rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-bold tabular-nums text-slate-700">{{displayOrder}}</span></td>
          <td class="whitespace-nowrap px-5 py-4 text-right"><div class="inline-flex items-center gap-1"><button type="button" class="rounded-lg px-3 py-2 text-xs font-semibold text-blue-800 transition hover:bg-blue-50" onclick="openEdit('editModal','editForm','{{jsonAttr this}}','/organizer/categories/{{id}}')">Edit</button><button type="button" class="rounded-lg px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50" onclick="openDelete('deleteModal','deleteForm','/organizer/categories/{{id}}/delete','{{jsonAttr name}}')">Delete</button></div></td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="4"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg></span><p class="mt-4 font-semibold text-slate-800">No matching categories</p><p class="mt-1 text-sm text-slate-500">Create a category to organize a competition's contestants.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
<div id="createModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="createCategoryTitle"><div class="w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl"><h2 id="createCategoryTitle" class="text-xl font-semibold text-slate-950">Create category</h2><p class="mb-5 mt-1 text-sm text-slate-500">Choose an event and define the category label and order.</p><form method="POST" action="/organizer/categories">{{> category-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('createModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-fair-700">Create category</button></div></form></div></div>
<div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="editCategoryTitle"><div class="w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl"><h2 id="editCategoryTitle" class="text-xl font-semibold text-slate-950">Update category</h2><p class="mb-5 mt-1 text-sm text-slate-500">Categories in use cannot be transferred between events or removed.</p><form id="editForm" method="POST">{{> category-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('editModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-fair-700">Save changes</button></div></form></div></div>
{{> delete-modal}}
{{> app-end}}
