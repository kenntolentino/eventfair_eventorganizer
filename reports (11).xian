{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div><div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div><div class="pointer-events-none absolute -bottom-24 right-1/4 h-56 w-56 rounded-full bg-amber-400/10 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-5 lg:flex-row lg:items-end"><div class="max-w-2xl"><span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-amber-300"></span>Live results &amp; audit snapshots</span><h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Tabulation reports</h1><p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Review live verified results from the selected event, then save and download a PDF snapshot of the actual scores, placements, and submission status.</p></div>{{#if selectedEvent}}<button type="button" onclick="openModal('createModal')" class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-400 px-4 py-2.5 text-sm font-bold text-slate-950 shadow-sm transition hover:bg-amber-300"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/></svg>Generate report</button>{{/if}}</div>
</section>
{{#if selectedEvent}}
<section class="mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-col justify-between gap-4 border-b border-slate-100 bg-gradient-to-r from-blue-50/70 via-white to-amber-50/60 p-5 sm:flex-row sm:items-center sm:p-6">
    <div class="flex items-start gap-3"><span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-800 ring-1 ring-blue-200"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 15 2 2 4-4"/></svg></span><div><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">Live event data</p><h2 class="mt-1 text-xl font-bold text-slate-950">{{selectedEvent.name}}</h2><p class="mt-1 text-sm text-slate-600">{{#if (eq selectedEvent.scoringFormula 'sum_weighted')}}Sum of weighted judge scores{{else}}Average of weighted judge scores{{/if}} <span class="mx-1 text-slate-300">·</span> Results shown only from verified or published tabulation records</p></div></div>
    <form method="GET" action="/tabulator/reports" class="flex w-full items-center gap-2 sm:w-auto"><label class="sr-only" for="reportEvent">Select assigned event</label><select id="reportEvent" name="eventId" class="min-w-48 w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-amber-500 focus:ring-4 focus:ring-amber-500/10 sm:w-auto" onchange="this.form.submit()">{{#each events}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></form>
  </div>
  <div class="grid grid-cols-2 gap-3 p-5 sm:grid-cols-3 lg:grid-cols-6 sm:p-6">
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Event status</p><p class="mt-2 font-bold capitalize text-slate-900">{{selectedEvent.status}}</p></div>
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Verified placements</p><p class="mt-2 font-bold text-slate-900">{{currentQuality.verifiedResultCount}}</p></div>
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Complete sheets</p><p class="mt-2 font-bold text-slate-900">{{currentQuality.completeSheets}} <span class="font-medium text-slate-400">/ {{currentQuality.expectedSheets}}</span></p></div>
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Submitted sheets</p><p class="mt-2 font-bold text-blue-800">{{currentQuality.submittedSheets}}</p></div>
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Draft sheets</p><p class="mt-2 font-bold text-amber-800">{{currentQuality.draftSheets}}</p></div>
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-3.5"><p class="text-[10px] font-bold uppercase tracking-[0.1em] text-slate-500">Open discrepancies</p><p class="mt-2 font-bold {{#if currentQuality.openIssues}}text-rose-800{{else}}text-emerald-800{{/if}}">{{currentQuality.openIssues}}</p></div>
  </div>
  {{#if currentStandings.length}}
  <div class="border-t border-slate-100">
    <div class="flex items-center gap-3 px-5 py-4 sm:px-6"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4M5 3h14v4a7 7 0 0 1-14 0V3Zm0 2H3v2a4 4 0 0 0 4 4m12-6h2v2a4 4 0 0 1-4 4"/></svg></span><div><h3 class="font-bold text-slate-950">Verified score standings</h3><p class="mt-1 text-xs text-slate-500">These standings are read from the latest verified or published results. Saved reports below remain historical snapshots as of their generation time.</p></div></div>
    <div class="overflow-x-auto"><table class="w-full min-w-[850px] text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.12em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Rank / placement</th><th class="px-5 py-4 font-bold">Contestant</th><th class="px-5 py-4 font-bold">Contestant number</th><th class="px-5 py-4 text-right font-bold">Verified score</th><th class="px-5 py-4 text-right font-bold">Raw total</th></tr></thead>
      <tbody class="divide-y divide-slate-100">{{#each currentStandings}}<tr class="transition hover:bg-amber-50/25"><td class="whitespace-nowrap px-5 py-3.5"><span class="inline-flex min-w-9 justify-center rounded-lg px-2 py-1 text-xs font-bold {{#if (eq rank 1)}}bg-amber-100 text-amber-900{{else}}bg-slate-100 text-slate-700{{/if}}">#{{rank}}</span><span class="ml-2 text-xs font-semibold {{#if (eq rank 1)}}text-amber-800{{else}}text-slate-500{{/if}}">{{placementLabel}}</span></td><td class="px-5 py-3.5 font-semibold text-slate-900">{{contestantName}}</td><td class="px-5 py-3.5 text-slate-700">#{{contestantNumber}}</td><td class="px-5 py-3.5 text-right font-bold tabular-nums text-slate-950">{{score}} <span class="text-xs font-normal text-slate-500">{{scoreLabel}}</span></td><td class="px-5 py-3.5 text-right tabular-nums text-slate-700">{{rawScore}}</td></tr>{{/each}}</tbody>
    </table></div>
  </div>
  {{else}}
  <div class="border-t border-slate-100 px-5 py-8 sm:px-6"><p class="font-semibold text-slate-800">No verified placements are recorded for this event yet.</p><p class="mt-1 max-w-3xl text-sm leading-6 text-slate-500">Current submissions: {{currentQuality.submittedSheets}} submitted and {{currentQuality.draftSheets}} draft. Draft scores are excluded from official results. Generate a report to save this event's current status, or compute verified rankings after all submissions are complete.</p></div>
  {{/if}}
</section>
{{else}}
<div class="mb-6 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg></span><h2 class="mt-4 font-semibold text-slate-800">No assigned events</h2><p class="mt-1 text-sm text-slate-500">A tabulator assignment is required to view data or generate a report.</p></div>
{{/if}}
<section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-amber-500"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">Saved snapshots for this event</p><p class="mt-2 text-3xl font-bold tracking-tight text-slate-950">{{stats.total}}</p><p class="mt-1 text-[10px] font-bold uppercase tracking-[0.12em] text-amber-700">Historical audit records</p></div><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span></div></article>
  <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm"><div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-slate-500">PDF contents</p><p class="mt-2 text-sm font-semibold leading-6 text-slate-900">Snapshot date · event status · sheet status · verified standings · contestant numbers · scores</p><p class="mt-1 text-[10px] font-bold uppercase tracking-[0.12em] text-blue-700">Downloadable report detail</p></div><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg></span></div></article>
</section>
<section class="space-y-4">
  <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span><div><h2 class="font-bold text-slate-950">Saved report snapshots</h2><p class="mt-0.5 text-xs text-slate-500">Historical records remain unchanged unless refreshed by an authorized tabulator.</p></div></div>
  {{#each reports}}
  <article class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition hover:shadow-md">
    <div class="flex flex-col justify-between gap-4 border-b border-slate-100 p-5 sm:flex-row sm:items-start sm:p-6">
      <div class="flex min-w-0 items-start gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span><div class="min-w-0"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-amber-700">Historical tabulation snapshot</p><h3 class="mt-1 text-lg font-bold text-slate-950">{{title}}</h3><p class="mt-1 text-sm text-slate-600">{{#if Event}}{{Event.name}}{{else}}Event unavailable{{/if}} <span class="mx-1 text-slate-300">·</span> Captured {{date createdAt}}</p><p class="mt-1 text-xs text-slate-500">Prepared by {{#if author}}{{author.name}}{{else}}tabulator{{/if}} <span class="mx-1 text-slate-300">·</span> Preserved as generated</p></div></div>
      <div class="flex shrink-0 flex-wrap gap-2"><a href="/tabulator/reports/{{id}}/pdf" class="inline-flex items-center gap-1.5 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-800"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>Download PDF</a>{{#if canManage}}<button type="button" class="rounded-lg border border-amber-200 bg-white px-3 py-2 text-xs font-semibold text-amber-800 transition hover:bg-amber-50" onclick="openEdit('editModal','editForm','{{jsonAttr editData}}','/tabulator/reports/{{id}}')">Refresh snapshot</button><button type="button" class="rounded-lg border border-rose-200 bg-white px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50" onclick="openDelete('deleteModal','deleteForm','/tabulator/reports/{{id}}/delete','{{jsonAttr title}}')">Delete</button>{{else}}<span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-600"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 10V7a4 4 0 1 1 8 0v3"/></svg>Read-only audit</span>{{/if}}</div>
    </div>
    <div class="bg-slate-50/50 p-5 sm:p-6"><pre class="whitespace-pre-wrap break-words rounded-xl border border-slate-100 bg-white p-4 font-sans text-sm leading-6 text-slate-700">{{summary}}</pre></div>
  </article>
  {{else}}
  <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M8 3h8v4H8zM8 13h8m-8 4h5"/></svg></span><h2 class="mt-4 font-semibold text-slate-800">No reports generated</h2><p class="mt-1 text-sm text-slate-500">Generate a report to capture this event's current tabulation status and ranking summary.</p></div>
  {{/each}}
</section>
<div id="createModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="createReportTitle"><div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl"><h2 id="createReportTitle" class="text-xl font-semibold text-slate-950">Generate tabulation report</h2><p class="mb-5 mt-1 text-sm leading-6 text-slate-500">The system saves the current completeness and verified standings as an audit snapshot. Download the saved report as a PDF from the report list.</p><form method="POST" action="/tabulator/reports">{{> report-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('createModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">Save report snapshot</button></div></form></div></div>
<div id="editModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="editReportTitle"><div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl"><h2 id="editReportTitle" class="text-xl font-semibold text-slate-950">Refresh report snapshot</h2><p class="mb-5 mt-1 text-sm text-slate-500">Refreshes this report with the event's latest saved scores, verified placements, and status. Optional notes are retained.</p><form id="editForm" method="POST">{{> report-edit-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('editModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">Refresh snapshot</button></div></form></div></div>
{{> delete-modal}}
{{> app-end}}
