<label class="mb-1 block text-sm font-semibold text-slate-700">Competition event</label>
<select name="eventId" required class="mb-4 w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-fair-500">{{#each events}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
<label class="mb-1 block text-sm font-semibold text-slate-700">Category name</label>
<input name="name" required class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-fair-500" />
<label class="mb-1 block text-sm font-semibold text-slate-700">Description</label>
<textarea name="description" rows="3" class="mb-4 w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-fair-500"></textarea>
<label class="mb-1 block text-sm font-semibold text-slate-700">Display order</label>
<input type="number" name="displayOrder" min="1" value="1" required class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-fair-500" />
