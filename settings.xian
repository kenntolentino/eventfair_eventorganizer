{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-fair-900 to-fair-800 px-6 py-7 text-white shadow-xl shadow-slate-900/10 sm:px-8 sm:py-9">
  <div class="pointer-events-none absolute -right-10 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -right-2 -top-12 h-48 w-48 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -bottom-28 right-40 h-56 w-56 rounded-full bg-fair-500/20 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        PLATFORM CONFIGURATION
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">System settings</h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300 sm:text-base">Manage platform configuration, review archived records, and keep operational settings organized.</p>
    </div>
    <button type="button" onclick="openModal('createModal')" class="inline-flex items-center justify-center gap-2 rounded-xl bg-fair-gold px-4 py-2.5 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-amber-300">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
      Add setting
    </button>
  </div>
</section>

<section class="mb-7 grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Settings overview">
  <article class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-center justify-between gap-3">
      <div><p class="text-sm font-medium text-slate-500">Configured values</p><p class="mt-2 text-3xl font-bold tracking-tight text-slate-950">{{systemSettings.length}}</p></div>
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.6a8 8 0 0 1-1.7 1l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.7-1l-1.7.6-1.4-2.4 1.4-1.1a7 7 0 0 1 0-2l-1.4-1.1 1.4-2.4 1.7.6a8 8 0 0 1 1.7-1l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.7 1l1.7-.6 1.4 2.4-1.4 1.1a7 7 0 0 1 0 1.9Z"/></svg></span>
    </div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Platform values currently in use</p>
  </article>
  <aside class="flex gap-3 rounded-2xl border border-blue-200/80 bg-gradient-to-br from-blue-50 to-white p-5 shadow-sm">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 11v5m0-8h.01"/></svg></span>
    <div><p class="text-sm font-bold text-blue-950">Configuration guidance</p><p class="mt-1 text-xs leading-5 text-blue-800">Changes can affect registration, result publication, and system behavior for all users.</p></div>
  </aside>
  <a href="#archive" class="group rounded-2xl border border-amber-200/80 bg-gradient-to-br from-amber-50 to-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-center justify-between gap-3">
      <div><p class="text-sm font-semibold text-amber-900">Archived records</p><p class="mt-2 text-3xl font-bold text-amber-950">{{archivedRecords.length}}</p></div>
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-amber-800" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/></svg></span>
    </div>
    <p class="mt-4 border-t border-amber-200/70 pt-3 text-xs text-amber-800">Review and restore records <span class="float-right font-bold transition group-hover:translate-x-1">&rarr;</span></p>
  </a>
</section>

<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-5 sm:px-6">
    <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-fair-700">Platform controls</p><h2 class="mt-1 text-lg font-bold text-slate-950">Configuration values</h2><p class="mt-1 text-sm text-slate-500">Review and update settings that govern system behavior.</p></div>
    <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold tabular-nums text-slate-600">{{systemSettings.length}} settings</span>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-[760px] w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50/80 text-[10px] uppercase tracking-[0.12em] text-slate-500">
        <tr><th scope="col" class="w-[23%] px-5 py-4 font-bold sm:px-6">Configuration key</th><th scope="col" class="w-[21%] px-5 py-4 font-bold sm:px-6">Current value</th><th scope="col" class="w-[39%] px-5 py-4 font-bold sm:px-6">Description</th><th scope="col" class="w-[17%] px-5 py-4 text-right font-bold sm:px-6">Actions</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {{#each systemSettings}}
        <tr class="group transition-colors hover:bg-blue-50/30">
          <td class="px-5 py-4 sm:px-6"><code class="inline-flex max-w-full items-center rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-semibold text-slate-800">{{settingKey}}</code></td>
          <td class="px-5 py-4 sm:px-6">
            {{#if (eq settingValue 'true')}}<span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Enabled</span>
            {{else if (eq settingValue 'false')}}<span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>Disabled</span>
            {{else}}<span class="font-medium text-slate-800">{{#if settingValue}}{{settingValue}}{{else}}<span class="text-slate-400">Not set</span>{{/if}}</span>{{/if}}
          </td>
          <td class="px-5 py-4 leading-6 text-slate-600 sm:px-6">{{#if description}}{{description}}{{else}}<span class="text-slate-400">No description</span>{{/if}}</td>
          <td class="whitespace-nowrap px-5 py-4 text-right sm:px-6">
            <div class="inline-flex items-center justify-end gap-1 rounded-xl border border-slate-200 bg-white p-1 shadow-sm transition group-hover:border-blue-100">
              <button type="button" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-fair-700 transition hover:bg-blue-50" onclick="openEdit('editModal','editForm','{{jsonAttr this}}','/admin/settings/{{id}}')">Edit</button>
              <button type="button" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-50" onclick="openDelete('deleteModal','deleteForm','/admin/settings/{{id}}/delete','{{jsonAttr settingKey}}')">Archive</button>
            </div>
          </td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-14 text-center" colspan="4"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.6a8 8 0 0 1-1.7 1l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.7-1l-1.7.6-1.4-2.4 1.4-1.1a7 7 0 0 1 0-2l-1.4-1.1 1.4-2.4 1.7.6a8 8 0 0 1 1.7-1l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.7 1l1.7-.6 1.4 2.4-1.4 1.1a7 7 0 0 1 0 1.9Z"/></svg></span><p class="mt-3 font-semibold text-slate-700">No settings configured</p><p class="mt-1 text-sm text-slate-500">Add a system setting to manage platform behavior.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

<section id="archive" class="mt-8 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-5 sm:px-6">
    <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-amber-700">Record recovery</p><h2 class="mt-1 text-lg font-bold text-slate-950">Archive</h2><p class="mt-1 text-sm text-slate-500">Restore archived accounts, events, settings, and homepage videos.</p></div>
    <span class="rounded-full bg-amber-50 px-3 py-1.5 text-xs font-semibold tabular-nums text-amber-800">{{archivedRecords.length}} archived</span>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-[680px] w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50/80 text-[10px] uppercase tracking-[0.12em] text-slate-500">
        <tr><th scope="col" class="w-[36%] px-5 py-4 font-bold sm:px-6">Record</th><th scope="col" class="w-[22%] px-5 py-4 font-bold sm:px-6">Type</th><th scope="col" class="w-[25%] px-5 py-4 font-bold sm:px-6">Archived</th><th scope="col" class="w-[17%] px-5 py-4 text-right font-bold sm:px-6">Action</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {{#each archivedRecords}}
        <tr class="transition-colors hover:bg-amber-50/30">
          <td class="px-5 py-4 font-semibold text-slate-900 sm:px-6">{{this.name}}</td>
          <td class="px-5 py-4 sm:px-6"><span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">{{this.typeLabel}}</span></td>
          <td class="px-5 py-4 text-xs text-slate-600 sm:px-6">{{date this.deletedAt}}</td>
          <td class="px-5 py-4 text-right sm:px-6">
            <form method="POST" action="/admin/archive/{{this.type}}/{{this.id}}/restore">
              <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-white px-3 py-1.5 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-50"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v5h5"/></svg>Restore</button>
            </form>
          </td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-12 text-center" colspan="4"><span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-slate-400"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6"/></svg></span><p class="mt-3 font-semibold text-slate-700">Archive is empty</p><p class="mt-1 text-sm text-slate-500">Archived records will appear here.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

<div id="createModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="createSettingTitle">
  <div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-white/60 bg-white shadow-2xl">
    <div class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-100 bg-white/95 px-6 py-5 backdrop-blur sm:px-8">
      <div><span class="inline-flex rounded-full bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">New configuration</span><h2 id="createSettingTitle" class="mt-2 text-xl font-bold text-slate-950">Add system setting</h2><p class="mt-1 text-sm text-slate-500">Use a unique key and a clear description for future administrators.</p></div>
      <button type="button" onclick="closeModal('createModal')" aria-label="Close dialog" class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">&times;</button>
    </div>
    <form method="POST" action="/admin/settings" class="px-6 py-5 sm:px-8">
      {{> setting-fields}}
      <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
        <button type="button" onclick="closeModal('createModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</button>
        <button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-fair-700">Add setting</button>
      </div>
    </form>
  </div>
</div>

<div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="editSettingTitle">
  <div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-white/60 bg-white shadow-2xl">
    <div class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-100 bg-white/95 px-6 py-5 backdrop-blur sm:px-8">
      <div><span class="inline-flex rounded-full bg-violet-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-violet-700">Configuration review</span><h2 id="editSettingTitle" class="mt-2 text-xl font-bold text-slate-950">Update system setting</h2><p class="mt-1 text-sm text-slate-500">Review the effect of a configuration change before saving.</p></div>
      <button type="button" onclick="closeModal('editModal')" aria-label="Close dialog" class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">&times;</button>
    </div>
    <form id="editForm" method="POST" class="px-6 py-5 sm:px-8">
      {{> setting-fields}}
      <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
        <button type="button" onclick="closeModal('editModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</button>
        <button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-fair-700">Save changes</button>
      </div>
    </form>
  </div>
</div>
{{> delete-modal}}
{{> app-end}}
