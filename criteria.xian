{{> app-start}}
<section class="mb-7">
  <p class="text-sm font-semibold uppercase tracking-wide text-violet-700">Official judging rubric</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Criteria &amp; guidelines</h1>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Review the event instructions, applicable categories, score ranges, and criterion weights before evaluating contestants.</p>
</section>
<section class="mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <form method="GET" action="/judge/criteria" class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center">
    <label class="sr-only" for="criteriaEvent">Filter by assigned event</label><select id="criteriaEvent" name="eventId" class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-violet-500"><option value="">All assigned events</option>{{#each events}}<option value="{{id}}" {{#if (eq ../filters.eventId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <label class="sr-only" for="criteriaSearch">Search criteria</label><input id="criteriaSearch" name="q" value="{{filters.q}}" placeholder="Search criteria name" class="min-w-0 flex-1 rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-violet-500" />
    <div class="flex gap-2"><button class="rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">Filter</button><a href="/judge/criteria" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Reset</a></div>
  </form>
</section>
{{#if selected}}
<section class="mb-6 rounded-2xl border border-violet-200 bg-violet-50 p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div><p class="text-xs font-semibold uppercase tracking-wide text-violet-700">Event instructions</p><h2 class="mt-1 text-lg font-semibold text-violet-950">{{selected.name}}</h2></div>
    <span class="rounded-full bg-white/80 px-2.5 py-1 text-xs font-semibold capitalize text-violet-800">{{selected.status}}</span>
  </div>
  <p class="mt-3 text-sm leading-6 text-violet-950">{{#if selected.evaluationInstructions}}{{selected.evaluationInstructions}}{{else}}No additional evaluation instructions have been provided.{{/if}}</p>
  {{#if selected.scoringNotes}}<p class="mt-3 border-t border-violet-200 pt-3 text-sm leading-6 text-violet-900"><span class="font-semibold">Scoring policy:</span> {{selected.scoringNotes}}</p>{{/if}}
  <p class="mt-2 text-xs text-violet-800">Formula: {{#if (eq selected.scoringFormula 'average_weighted')}}Average of weighted judge scores{{else}}Sum of weighted judge scores{{/if}} · Your score sheet is private to you and the authorized tabulation workflow.</p>
</section>
{{else}}
<section class="mb-6 grid grid-cols-1 gap-4 xl:grid-cols-2">
  {{#each events}}
  <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><h2 class="font-semibold text-slate-900">{{name}}</h2><span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold capitalize text-slate-600">{{status}}</span></div><p class="mt-2 text-sm leading-6 text-slate-600">{{#if evaluationInstructions}}{{evaluationInstructions}}{{else}}No additional evaluation instructions provided.{{/if}}</p>{{#if scoringNotes}}<p class="mt-2 text-xs leading-5 text-slate-500">{{scoringNotes}}</p>{{/if}}<a class="mt-3 inline-block text-sm font-semibold text-violet-800" href="/judge/criteria?eventId={{id}}">View event rubric</a></article>
  {{else}}
  <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 xl:col-span-2">No assigned event guidelines are available.</p>
  {{/each}}
</section>
{{/if}}
<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4"><div><h2 class="font-semibold text-slate-950">Published criteria</h2><p class="mt-1 text-xs text-slate-500">Category-specific criteria apply only to contestants in that category; general criteria apply to all categories.</p></div><p class="text-xs text-slate-500">{{stats.total}} listed</p></div>
  <div class="overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3.5 font-semibold">Criterion</th><th class="px-5 py-3.5 font-semibold">Event &amp; category</th><th class="px-5 py-3.5 font-semibold">Weight</th><th class="px-5 py-3.5 font-semibold">Score range</th><th class="px-5 py-3.5 font-semibold">Evaluation guideline</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each criteria}}
        <tr class="align-top hover:bg-slate-50/70"><td class="px-5 py-4 font-semibold text-slate-900">{{name}}</td><td class="px-5 py-4"><p class="font-medium text-slate-700">{{#if Event}}{{Event.name}}{{else}}—{{/if}}</p><p class="mt-1 text-xs text-slate-500">{{#if Category}}{{Category.name}}{{else}}General criteria{{/if}}</p></td><td class="whitespace-nowrap px-5 py-4 font-semibold text-slate-800">{{weightPercentage}}%</td><td class="whitespace-nowrap px-5 py-4 text-slate-600">{{minScore}}–{{maxScore}}</td><td class="max-w-lg px-5 py-4 leading-6 text-slate-600">{{#if description}}{{description}}{{else}}No additional guideline provided.{{/if}}</td></tr>
        {{else}}
        <tr><td class="px-5 py-14 text-center" colspan="5"><p class="font-semibold text-slate-700">No criteria available</p><p class="mt-1 text-sm text-slate-500">Ask the event organizer to publish the judging rubric before scoring.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{> app-end}}
