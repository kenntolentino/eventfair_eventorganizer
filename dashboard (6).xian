{{> app-start}}
<section class="relative mb-8 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-8 text-white shadow-xl shadow-blue-950/10 sm:px-9 sm:py-10">
  <div class="pointer-events-none absolute -right-20 -top-32 h-80 w-80 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-8 -top-20 h-56 w-56 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -bottom-28 right-1/4 h-64 w-64 rounded-full bg-blue-400/10 blur-3xl"></div>
  <div class="relative z-10 flex flex-col justify-between gap-8 xl:flex-row xl:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.65)]"></span>
        Organizer workspace
      </span>
      <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl lg:text-[2.65rem]">Welcome, {{currentUser.name}}</h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-blue-100/80 sm:text-base">Plan your competitions, coordinate judges and tabulators, and follow results through to publication.</p>
    </div>
    <div class="relative flex flex-wrap gap-3">
      <a href="/organizer/progress" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/[0.08] px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/[0.15]">
        View progress
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
      <a href="/organizer/events" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/></svg>
        Manage events
      </a>
    </div>
  </div>
  <div class="relative z-10 mt-8 flex flex-wrap gap-x-6 gap-y-2 border-t border-white/10 pt-5 text-xs font-medium text-blue-100/75">
    <a href="/organizer/contestants" class="transition hover:text-white">Contestants <span class="ml-1 text-white/40" aria-hidden="true">&rarr;</span></a>
    <a href="/organizer/assignments" class="transition hover:text-white">Officials <span class="ml-1 text-white/40" aria-hidden="true">&rarr;</span></a>
    <a href="/organizer/reports" class="transition hover:text-white">Reports <span class="ml-1 text-white/40" aria-hidden="true">&rarr;</span></a>
  </div>
</section>

<section class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 2xl:grid-cols-4" aria-label="Organizer summary">
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div>
    <div class="flex items-start justify-between gap-3">
      <div><p class="text-sm font-semibold text-slate-600">My events</p><p class="mt-4 text-3xl font-bold tracking-tight text-slate-950">{{stats.events}}</p></div>
      <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg>
      </span>
    </div>
    <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
      <p class="text-xs text-slate-500"><span class="font-semibold text-blue-700">{{stats.activeEvents}}</span> in progress</p>
      <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">Events</span>
    </div>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-violet-500"></div>
    <div class="flex items-start justify-between gap-3">
      <div><p class="text-sm font-semibold text-slate-600">Registered contestants</p><p class="mt-4 text-3xl font-bold tracking-tight text-slate-950">{{stats.contestants}}</p></div>
      <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg>
      </span>
    </div>
    <div class="mt-4 border-t border-slate-100 pt-3">
      <a href="/organizer/contestants" class="inline-flex items-center gap-1 text-xs font-semibold text-violet-700 transition hover:text-violet-900">Manage contestants <span aria-hidden="true">&rarr;</span></a>
    </div>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-amber-500"></div>
    <div class="flex items-start justify-between gap-3">
      <div><p class="text-sm font-semibold text-slate-600">Assigned officials</p><p class="mt-4 text-3xl font-bold tracking-tight text-slate-950">{{stats.assignments}}</p></div>
      <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-amber-100">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 20a6 6 0 0 1 12 0m3-12v6m-3-3h6"/></svg>
      </span>
    </div>
    <div class="mt-4 border-t border-slate-100 pt-3">
      <a href="/organizer/assignments" class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 transition hover:text-amber-900">Manage assignments <span aria-hidden="true">&rarr;</span></a>
    </div>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></div>
    <div class="flex items-start justify-between gap-3">
      <div><p class="text-sm font-semibold text-slate-600">Published events</p><p class="mt-4 text-3xl font-bold tracking-tight text-slate-950">{{stats.publishedEvents}}</p></div>
      <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/><circle cx="12" cy="12" r="9"/></svg>
      </span>
    </div>
    <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
      <p class="text-xs text-slate-500"><span class="font-semibold text-emerald-700">{{stats.submittedSheets}}</span> score sheets submitted</p>
      <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Results</span>
    </div>
  </article>
</section>

<section class="mb-8 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 px-5 py-5 sm:px-6">
    <div class="flex items-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-700">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h17"/><path stroke-linecap="round" stroke-linejoin="round" d="m7 15 4-4 3 2 5-6"/></svg>
      </span>
      <div><h2 class="text-base font-bold text-slate-950">Competition workflow</h2><p class="mt-0.5 text-xs text-slate-500 sm:text-sm">From initial planning to approved publication.</p></div>
    </div>
    <a href="/organizer/progress" class="inline-flex items-center gap-1 text-sm font-semibold text-blue-800 transition hover:text-blue-950">View judging progress <span aria-hidden="true">&rarr;</span></a>
  </div>
  <ol class="grid grid-cols-1 gap-3 p-5 sm:p-6 md:grid-cols-2 2xl:grid-cols-4">
    <li class="relative rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:border-blue-200 hover:bg-blue-50/50">
      <div class="flex items-center justify-between"><span class="text-[10px] font-bold uppercase tracking-[0.16em] text-blue-800">01 · Plan</span><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100 text-xs font-bold text-blue-800">01</span></div>
      <h3 class="mt-4 text-sm font-bold text-slate-900">Set up event</h3><p class="mt-1 text-xs leading-5 text-slate-500">Add schedule, venue, rules, and scoring formula.</p>
    </li>
    <li class="relative rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:border-violet-200 hover:bg-violet-50/40">
      <div class="flex items-center justify-between"><span class="text-[10px] font-bold uppercase tracking-[0.16em] text-violet-800">02 · Prepare</span><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-100 text-xs font-bold text-violet-800">02</span></div>
      <h3 class="mt-4 text-sm font-bold text-slate-900">Configure competition</h3><p class="mt-1 text-xs leading-5 text-slate-500">Register contestants, categories, and weighted criteria.</p>
    </li>
    <li class="relative rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:border-amber-200 hover:bg-amber-50/50">
      <div class="flex items-center justify-between"><span class="text-[10px] font-bold uppercase tracking-[0.16em] text-amber-800">03 · Coordinate</span><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-xs font-bold text-amber-800">03</span></div>
      <h3 class="mt-4 text-sm font-bold text-slate-900">Assign officials</h3><p class="mt-1 text-xs leading-5 text-slate-500">Assign judges and tabulators, then monitor submissions.</p>
    </li>
    <li class="relative rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:border-emerald-200 hover:bg-emerald-50/50">
      <div class="flex items-center justify-between"><span class="text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-800">04 · Finalize</span><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-xs font-bold text-emerald-800">04</span></div>
      <h3 class="mt-4 text-sm font-bold text-slate-900">Review &amp; publish</h3><p class="mt-1 text-xs leading-5 text-slate-500">Review tabulation reports and approve verified results.</p>
    </li>
  </ol>
</section>

<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 px-5 py-5 sm:px-6">
    <div class="flex items-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18"/></svg>
      </span>
      <div><h2 class="text-base font-bold text-slate-950">Your event records</h2><p class="mt-0.5 text-xs text-slate-500 sm:text-sm">Events created under your organizer account.</p></div>
    </div>
    <a href="/organizer/events" class="inline-flex items-center gap-1 text-sm font-semibold text-blue-800 transition hover:text-blue-950">View all events <span aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <thead class="bg-slate-50/80 text-[10px] uppercase tracking-[0.14em] text-slate-500"><tr><th class="px-5 py-3.5 font-bold sm:px-6">Event</th><th class="px-5 py-3.5 font-bold sm:px-6">Venue</th><th class="px-5 py-3.5 font-bold sm:px-6">Schedule</th><th class="px-5 py-3.5 font-bold sm:px-6">Status</th><th class="px-5 py-3.5 text-right font-bold sm:px-6">Next step</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each events}}
        <tr class="transition hover:bg-blue-50/40">
          <td class="px-5 py-4 sm:px-6"><p class="font-semibold text-slate-900">{{name}}</p><p class="mt-1 text-xs text-slate-500">{{scoringFormula}}</p></td>
          <td class="px-5 py-4 text-slate-600 sm:px-6">{{#if venue}}{{venue}}{{else}}Not set{{/if}}</td>
          <td class="whitespace-nowrap px-5 py-4 text-slate-600 sm:px-6">{{#if startDate}}{{startDate}}{{else}}Not scheduled{{/if}} {{#if endDate}}– {{endDate}}{{/if}}</td>
          <td class="px-5 py-4 sm:px-6"><span class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold capitalize text-slate-700">{{status}}</span></td>
          <td class="px-5 py-4 text-right sm:px-6"><a href="/organizer/progress" class="inline-flex items-center gap-1 whitespace-nowrap text-xs font-semibold text-blue-800 transition hover:text-blue-950">Review workflow <span aria-hidden="true">&rarr;</span></a></td>
        </tr>
        {{else}}
        <tr><td class="px-6 py-14 text-center" colspan="5">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18m-9 4h.01"/></svg></span>
          <p class="mt-4 font-semibold text-slate-800">Your workspace is ready</p><p class="mt-1 text-sm text-slate-500">Create your first event to begin competition setup.</p><a href="/organizer/events" class="mt-4 inline-flex items-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65]"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/></svg>Create an event</a>
        </td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
{{> app-end}}
