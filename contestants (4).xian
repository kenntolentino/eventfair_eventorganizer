{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        Competition roster
      </span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Contestants</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Register participants, organize them by event and category, and maintain accurate competition records.</p>
    </div>
    <button type="button" onclick="openModal('createModal')" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/></svg>
      Register contestant
    </button>
  </div>
</section>
<section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Contestant summary">
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div>
    <div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Contestant records</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.total}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">All records</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-emerald-500"></div>
    <div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Currently registered</p><p class="mt-3 text-3xl font-bold tracking-tight text-emerald-700">{{stats.registered}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/><circle cx="12" cy="12" r="9"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Active entries</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-violet-500"></div>
    <div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Matching records</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.shown}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/></svg></span></div>
    <p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-violet-700">Current filter results</p>
  </article>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <div><h2 class="text-base font-bold text-slate-950">Contestant directory</h2><p class="mt-0.5 text-xs text-slate-500 sm:text-sm">Search, filter, and maintain participant records.</p></div>
    <span class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-800"><span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>{{stats.shown}} matching</span>
  </div>
  <form method="GET" action="/organizer/contestants" class="grid gap-3 border-b border-slate-100 bg-slate-50/60 p-4 sm:p-5 xl:grid-cols-[minmax(240px,1fr)_200px_180px_auto] xl:items-end">
    <label class="sr-only" for="contestantSearch">Search contestants</label>
    <div class="relative">
      <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/></svg>
      <input id="contestantSearch" name="q" value="{{filters.q}}" placeholder="Search name, number, or organization" class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>
    <label class="sr-only" for="contestantEvent">Filter by event</label>
    <select id="contestantEvent" name="eventId" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"><option value="">All events</option>{{#each events}}<option value="{{id}}" {{#if (eq ../filters.eventId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <label class="sr-only" for="contestantStatus">Filter by status</label>
    <select id="contestantStatus" name="status" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"><option value="">All statuses</option><option value="registered" {{#if (eq filters.status 'registered')}}selected{{/if}}>Registered</option><option value="withdrawn" {{#if (eq filters.status 'withdrawn')}}selected{{/if}}>Withdrawn</option><option value="disqualified" {{#if (eq filters.status 'disqualified')}}selected{{/if}}>Disqualified</option></select>
    <div class="flex gap-2"><button class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65] xl:flex-none"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16l-6.5 7.5v5L10.5 19v-6.5L4 5Z"/></svg>Filter</button><a href="/organizer/contestants" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 xl:flex-none">Reset</a></div>
  </form>
  <div class="overflow-x-auto">
    <table class="min-w-[900px] w-full text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.14em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Contestant</th><th class="px-5 py-4 font-bold">Competition</th><th class="px-5 py-4 font-bold">Category</th><th class="px-5 py-4 font-bold">Organization</th><th class="px-5 py-4 font-bold">Status</th><th class="px-5 py-4 text-right font-bold">Actions</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each contestants}}
        <tr class="transition hover:bg-blue-50/40">
          <td class="px-5 py-4"><div class="flex items-center gap-3"><div class="flex h-11 w-11 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-blue-50 to-indigo-100 text-xs font-bold text-blue-700 ring-1 ring-blue-100">{{#if imageUrl}}<img src="{{imageUrl}}" alt="{{fullName}}" class="h-full w-full object-cover" loading="lazy" />{{else}}<span aria-hidden="true">{{contestantNumber}}</span>{{/if}}</div><div><p class="font-semibold text-slate-900">{{fullName}}</p><p class="mt-1 text-xs text-slate-500">Contestant #{{contestantNumber}}{{#if age}} · Age {{age}}{{/if}}{{#if gender}} · {{gender}}{{/if}}</p></div></div></td>
          <td class="px-5 py-4"><span class="font-medium text-slate-800">{{#if Event}}{{Event.name}}{{else}}—{{/if}}</span></td>
          <td class="px-5 py-4 text-slate-600">{{#if Category}}{{Category.name}}{{else}}<span class="text-slate-400">General</span>{{/if}}</td>
          <td class="px-5 py-4 text-slate-600">{{#if organization}}{{organization}}{{else}}<span class="text-slate-400">—</span>{{/if}}</td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold capitalize {{#if (eq status 'registered')}}border-emerald-200 bg-emerald-50 text-emerald-800{{else if (eq status 'withdrawn')}}border-amber-200 bg-amber-50 text-amber-800{{else}}border-rose-200 bg-rose-50 text-rose-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq status 'registered')}}bg-emerald-500{{else if (eq status 'withdrawn')}}bg-amber-500{{else}}bg-rose-500{{/if}}"></span>{{status}}</span></td>
          <td class="whitespace-nowrap px-5 py-4 text-right">
            <div class="inline-flex items-center gap-1">
              <button type="button" class="rounded-lg px-3 py-2 text-xs font-semibold text-blue-800 transition hover:bg-blue-50" onclick="openEdit('editModal','editForm','{{jsonAttr this}}','/organizer/contestants/{{id}}')">Edit</button>
              <button type="button" class="rounded-lg px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50" onclick="openDelete('deleteModal','deleteForm','/organizer/contestants/{{id}}/delete','{{jsonAttr fullName}}')">Delete</button>
            </div>
          </td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="6"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/></svg></span><p class="mt-4 font-semibold text-slate-800">No matching contestants</p><p class="mt-1 text-sm text-slate-500">Adjust the filters or register a contestant.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
<div id="createModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="createContestantTitle">
  <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
    <h2 id="createContestantTitle" class="text-xl font-semibold text-slate-950">Register contestant</h2><p class="mb-5 mt-1 text-sm text-slate-500">Add participant details and assign an event and optional category.</p>
    <form method="POST" action="/organizer/contestants" enctype="multipart/form-data">{{> contestant-fields}}
      <div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('createModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-fair-700">Register contestant</button></div>
    </form>
  </div>
</div>
<div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="editContestantTitle">
  <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
    <h2 id="editContestantTitle" class="text-xl font-semibold text-slate-950">Update contestant</h2><p class="mb-5 mt-1 text-sm text-slate-500">Contestants with scoring history remain protected from deletion or event transfer.</p>
    <form id="editForm" method="POST" enctype="multipart/form-data">{{> contestant-fields}}
      <div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('editModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-fair-700">Save changes</button></div>
    </form>
  </div>
</div>
{{> delete-modal}}
{{> app-end}}
