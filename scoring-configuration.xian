{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-fair-900 to-fair-800 px-6 py-7 text-white shadow-xl shadow-slate-900/10 sm:px-8 sm:py-9">
  <div class="pointer-events-none absolute -right-10 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -right-2 -top-12 h-48 w-48 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -bottom-28 right-40 h-56 w-56 rounded-full bg-fair-500/20 blur-3xl"></div>
  <div class="relative flex items-center gap-4">
    <span class="hidden h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl border border-white/15 bg-white/10 text-fair-gold sm:flex" aria-hidden="true">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 4.5 7v5c0 4.8 3.2 7.7 7.5 9 4.3-1.3 7.5-4.2 7.5-9V7L12 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12 2.2 2.2 4.8-4.8"/></svg>
    </span>
    <div>
      <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        TRANSPARENT OVERSIGHT
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Scoring configuration</h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-300 sm:text-base">Review event criteria, score weights, and scoring formulas in one place. This page is read-only so configuration remains with the authorized event workflow.</p>
    </div>
  </div>
</section>

<aside class="mb-7 flex gap-4 rounded-2xl border border-blue-200/80 bg-gradient-to-r from-blue-50 to-white p-4 shadow-sm sm:p-5" aria-label="Configuration permissions">
  <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-700" aria-hidden="true">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 11v5m0-8h.01"/></svg>
  </span>
  <div>
    <p class="font-semibold text-blue-950">Read-only configuration</p>
    <p class="mt-1 text-sm leading-6 text-blue-900/80">Changes to criteria and weights are not made here. Contact the authorized event organizer to request a tracked configuration change before score submissions.</p>
  </div>
</aside>

<section class="space-y-5" aria-label="Event scoring configurations">
  {{#each configurations}}
  <article class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex flex-col justify-between gap-5 border-b border-slate-100 bg-gradient-to-r from-white to-slate-50/70 px-5 py-5 sm:flex-row sm:items-center sm:px-6">
      <div class="min-w-0">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-100 bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-blue-800">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>{{status}}
          </span>
          <span class="text-xs font-medium text-slate-400">Event configuration</span>
        </div>
        <h2 class="truncate text-lg font-bold text-slate-950 sm:text-xl">{{eventName}}</h2>
        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 sm:text-sm">
          <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>{{categoryName}}</span>
          <span class="hidden text-slate-300 sm:inline">•</span>
          <span>{{scoringFormula}}</span>
        </div>
      </div>
      <div class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm sm:min-w-52 sm:justify-between">
        <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl {{#if isValid}}bg-emerald-50 text-emerald-700{{else}}bg-amber-50 text-amber-700{{/if}}" aria-hidden="true">
          {{#if isValid}}
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/></svg>
          {{else}}
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
          {{/if}}
        </span>
        <div class="flex-1 sm:text-right">
          <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Applicable weight total</p>
          <p class="mt-0.5 text-xl font-bold tabular-nums {{#if isValid}}text-emerald-700{{else}}text-amber-700{{/if}}">{{totalWeight}}%</p>
          <p class="text-xs font-medium {{#if isValid}}text-emerald-700{{else}}text-amber-700{{/if}}">{{#if isValid}}Weights total 100%{{else}}Review required{{/if}}</p>
        </div>
      </div>
    </div>
    <div class="flex items-center justify-between gap-3 px-5 pb-3 pt-5 sm:px-6">
      <div>
        <p class="text-sm font-bold text-slate-900">Scoring rubric</p>
        <p class="mt-0.5 text-xs text-slate-500">Criteria, scope, and contribution to the final score</p>
      </div>
      <span class="hidden rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-semibold text-slate-500 sm:inline-flex">WEIGHT DISTRIBUTION</span>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-[700px] w-full text-left text-sm">
        <thead class="text-[10px] uppercase tracking-[0.12em] text-slate-500">
          <tr class="border-y border-slate-100 bg-slate-50/80">
            <th scope="col" class="w-[36%] px-5 py-3 font-bold sm:px-6">Criterion</th>
            <th scope="col" class="w-[24%] px-5 py-3 font-bold sm:px-6">Scope</th>
            <th scope="col" class="w-[25%] px-5 py-3 font-bold sm:px-6">Weight</th>
            <th scope="col" class="w-[15%] px-5 py-3 text-right font-bold sm:px-6">Score range</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each criteria}}
          <tr class="transition-colors hover:bg-blue-50/30">
            <td class="px-5 py-4 sm:px-6">
              <p class="font-semibold text-slate-900">{{name}}</p>
              {{#if description}}<p class="mt-1 max-w-xl text-xs leading-5 text-slate-500">{{description}}</p>{{/if}}
            </td>
            <td class="px-5 py-4 text-slate-600 sm:px-6">
              <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span>{{#if Category}}{{Category.name}}{{else}}All categories{{/if}}</span>
            </td>
            <td class="px-5 py-4 sm:px-6">
              <div class="flex items-center gap-3">
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-gradient-to-r from-fair-500 to-blue-400" style="width: {{weightPercentage}}%"></div></div>
                <span class="w-12 text-right font-bold tabular-nums text-slate-800">{{weightPercentage}}%</span>
              </div>
            </td>
            <td class="px-5 py-4 text-right tabular-nums text-slate-600 sm:px-6"><span class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold">{{minScore}} – {{maxScore}}</span></td>
          </tr>
          {{else}}
          <tr><td colspan="4" class="px-6 py-10 text-center"><span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-slate-400"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></span><p class="mt-3 text-sm font-semibold text-slate-700">No criteria configured</p><p class="mt-1 text-xs text-slate-500">No scoring criteria are configured for this scope.</p></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 bg-slate-50/50 px-5 py-3 text-xs text-slate-500 sm:px-6">
      <span>Scoring formula: <span class="font-semibold text-slate-700">{{scoringFormula}}</span></span>
      <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full {{#if isValid}}bg-emerald-500{{else}}bg-amber-500{{/if}}"></span>{{#if isValid}}Configuration verified{{else}}Configuration needs review{{/if}}</span>
    </div>
  </article>
  {{else}}
  <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center shadow-sm">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-700"><svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></span>
    <h2 class="mt-4 text-lg font-bold text-slate-900">No scoring configuration found</h2>
    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">Event criteria will appear here after they are configured by an authorized organizer.</p>
  </div>
  {{/each}}
</section>
{{> app-end}}
