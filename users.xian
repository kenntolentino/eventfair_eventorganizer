{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-fair-900 to-fair-800 px-6 py-7 text-white shadow-xl shadow-slate-900/10 sm:px-8 sm:py-9">
  <div class="pointer-events-none absolute -right-10 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -right-2 -top-12 h-48 w-48 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute -bottom-28 right-40 h-56 w-56 rounded-full bg-fair-500/20 blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-blue-100">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        ACCESS CONTROL
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">User accounts &amp; roles</h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300 sm:text-base">Manage platform access with confidence. Create accounts, assign the right responsibilities, and keep user information current.</p>
    </div>
    <button type="button" onclick="openModal('createModal')" class="inline-flex items-center justify-center gap-2 rounded-xl bg-fair-gold px-4 py-2.5 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-amber-300">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
      Add user account
    </button>
  </div>
</section>

<section class="mb-7 grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Account summary">
  <article class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-center justify-between gap-3">
      <div><p class="text-sm font-medium text-slate-500">All accounts</p><p class="mt-2 text-3xl font-bold tracking-tight text-slate-950">{{stats.total}}</p></div>
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span>
    </div>
    <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Registered on the platform</div>
  </article>
  <article class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-center justify-between gap-3">
      <div><p class="text-sm font-medium text-slate-500">Active access</p><p class="mt-2 text-3xl font-bold tracking-tight text-emerald-700">{{stats.active}}</p></div>
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg></span>
    </div>
    <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Accounts currently enabled</div>
  </article>
  <article class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-center justify-between gap-3">
      <div><p class="text-sm font-medium text-slate-500">Matching records</p><p class="mt-2 text-3xl font-bold tracking-tight text-slate-950">{{stats.shown}}</p></div>
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-50 text-violet-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-4-4"/></svg></span>
    </div>
    <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Accounts shown with current filters</div>
  </article>
</section>

<section class="mb-7">
  <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
    <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-fair-700">Permissions at a glance</p><h2 class="mt-1 text-lg font-bold text-slate-950">System roles &amp; access</h2></div>
    <p class="text-sm text-slate-500">Assign only the access needed for each responsibility.</p>
  </div>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    {{#each roles}}
    <article class="group rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md">
      <div class="flex items-center justify-between gap-2">
        <h3 class="text-sm font-bold text-slate-900">{{label}}</h3>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold tabular-nums text-slate-600 transition group-hover:bg-blue-50 group-hover:text-blue-700">{{count}}</span>
      </div>
      <p class="mt-2 text-xs leading-5 text-slate-600">{{description}}</p>
      <div class="mt-4 h-1 overflow-hidden rounded-full bg-slate-100"><div class="h-full w-1/2 rounded-full bg-gradient-to-r from-fair-500 to-blue-400 transition-all group-hover:w-3/4"></div></div>
    </article>
    {{/each}}
  </div>
</section>

<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-5 sm:px-6">
    <div><p class="text-xs font-bold uppercase tracking-[0.14em] text-fair-700">Directory</p><h2 class="mt-1 text-lg font-bold text-slate-950">Manage accounts</h2><p class="mt-1 text-sm text-slate-500">Search people and review their current access.</p></div>
    <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold tabular-nums text-slate-600">{{stats.shown}} shown</span>
  </div>
  <form method="GET" action="/admin/users" class="grid gap-3 border-b border-slate-100 bg-slate-50/60 p-4 sm:grid-cols-[minmax(0,1fr)_170px_155px_auto] sm:items-center sm:px-5">
    <label class="relative block min-w-0">
      <span class="sr-only">Search accounts</span>
      <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-4-4"/></svg>
      <input id="accountSearch" name="q" value="{{filters.q}}" placeholder="Search name, email, or organization" class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-fair-500 focus:ring-4 focus:ring-fair-500/10" />
    </label>
    <label><span class="sr-only">Filter by role</span>
      <select id="roleFilter" name="role" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-fair-500 focus:ring-4 focus:ring-fair-500/10">
        <option value="">All roles</option>
        {{#each roles}}<option value="{{value}}" {{#if (eq ../filters.role value)}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label><span class="sr-only">Filter by status</span>
      <select id="statusFilter" name="status" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-700 outline-none transition focus:border-fair-500 focus:ring-4 focus:ring-fair-500/10">
        <option value="">All statuses</option>
        <option value="active" {{#if (eq filters.status 'active')}}selected{{/if}}>Active</option>
        <option value="inactive" {{#if (eq filters.status 'inactive')}}selected{{/if}}>Inactive</option>
      </select>
    </label>
    <div class="flex gap-2">
      <button class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700">Filter</button>
      <a href="/admin/users" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Reset</a>
    </div>
  </form>
  <div class="overflow-x-auto">
    <table class="min-w-[920px] w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50/80 text-[10px] uppercase tracking-[0.12em] text-slate-500">
        <tr>
          <th scope="col" class="w-[28%] px-5 py-4 font-bold sm:px-6">Account</th>
          <th scope="col" class="w-[17%] px-5 py-4 font-bold sm:px-6">Role / access</th>
          <th scope="col" class="w-[21%] px-5 py-4 font-bold sm:px-6">Organization</th>
          <th scope="col" class="w-[13%] px-5 py-4 font-bold sm:px-6">Status</th>
          <th scope="col" class="w-[21%] px-5 py-4 text-right font-bold sm:px-6">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {{#each users}}
        <tr class="group transition-colors hover:bg-blue-50/40">
          <td class="px-5 py-4 sm:px-6">
            <div class="flex min-w-0 items-center gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-gradient-to-br from-blue-50 to-indigo-100 text-blue-700" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.25"/><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg>
              </span>
              <div class="min-w-0">
                <p class="truncate font-semibold text-slate-900">{{name}}</p>
                <p class="mt-1 truncate text-xs text-slate-500">{{email}}</p>
              </div>
            </div>
          </td>
          <td class="px-5 py-4 sm:px-6"><span class="inline-flex items-center rounded-lg border border-blue-100 bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-800">{{roleName}}</span></td>
          <td class="px-5 py-4 sm:px-6">
            {{#if organization}}<span class="block max-w-[190px] truncate font-medium text-slate-700" title="{{organization}}">{{organization}}</span>{{else}}<span class="text-xs text-slate-400">Not provided</span>{{/if}}
          </td>
          <td class="px-5 py-4 sm:px-6">
            {{#if (eq status 'active')}}
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Active</span>
            {{else}}
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>Inactive</span>
            {{/if}}
          </td>
          <td class="whitespace-nowrap px-5 py-4 text-right sm:px-6">
            <div class="inline-flex items-center justify-end gap-1 rounded-xl border border-slate-200 bg-white p-1 shadow-sm transition group-hover:border-blue-100">
              <button type="button" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-fair-700 transition hover:bg-blue-50" onclick="openEdit('editModal','editForm','{{jsonAttr this}}','/admin/users/{{id}}')">Edit</button>
              <form method="POST" action="/admin/users/{{id}}/toggle">
                <button class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-amber-700 transition hover:bg-amber-50">{{#if (eq status 'active')}}Deactivate{{else}}Activate{{/if}}</button>
              </form>
              <button type="button" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-50" onclick="openDelete('deleteModal','deleteForm','/admin/users/{{id}}/delete','{{jsonAttr name}}')">Archive</button>
            </div>
          </td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-14 text-center" colspan="5"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-4-4"/></svg></span><p class="mt-3 font-semibold text-slate-700">No matching user accounts</p><p class="mt-1 text-sm text-slate-500">Adjust the filters or add an account to get started.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

<div id="createModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="createUserTitle">
  <div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-white/60 bg-white shadow-2xl">
    <div class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-100 bg-white/95 px-6 py-5 backdrop-blur sm:px-8">
      <div><span class="inline-flex rounded-full bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">New account</span><h2 id="createUserTitle" class="mt-2 text-xl font-bold text-slate-950">Create user account</h2><p class="mt-1 text-sm text-slate-500">Set the account identity, role, and access status.</p></div>
      <button type="button" onclick="closeModal('createModal')" aria-label="Close dialog" class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">&times;</button>
    </div>
    <form method="POST" action="/admin/users" class="px-6 py-5 sm:px-8">
      {{> user-fields requiredPassword=true}}
      <div class="mt-3 flex items-center gap-2 rounded-xl bg-blue-50 px-3.5 py-3 text-xs leading-5 text-blue-800"><svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 11v5m0-8h.01"/></svg>A secure password of at least 8 characters is required for a new account.</div>
      <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
        <button type="button" onclick="closeModal('createModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</button>
        <button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-fair-700">Create account</button>
      </div>
    </form>
  </div>
</div>

<div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="editUserTitle">
  <div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-white/60 bg-white shadow-2xl">
    <div class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-100 bg-white/95 px-6 py-5 backdrop-blur sm:px-8">
      <div><span class="inline-flex rounded-full bg-violet-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-violet-700">Account settings</span><h2 id="editUserTitle" class="mt-2 text-xl font-bold text-slate-950">Update user account</h2><p class="mt-1 text-sm text-slate-500">Update profile details or change the assigned system role.</p></div>
      <button type="button" onclick="closeModal('editModal')" aria-label="Close dialog" class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">&times;</button>
    </div>
    <form id="editForm" method="POST" class="px-6 py-5 sm:px-8">
      {{> user-fields}}
      <div class="-mt-1 mb-3 flex items-center gap-2 rounded-xl bg-slate-50 px-3.5 py-3 text-xs leading-5 text-slate-600"><svg class="h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 11v5m0-8h.01"/></svg>Leave password blank to keep the current password.</div>
      <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
        <button type="button" onclick="closeModal('editModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</button>
        <button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-fair-700">Save changes</button>
      </div>
    </form>
  </div>
</div>
{{> delete-modal}}
{{> app-end}}
