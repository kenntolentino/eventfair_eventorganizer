{{> app-start}}
<section class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#0b1429] via-[#102947] to-[#193e65] px-6 py-7 text-white shadow-xl shadow-blue-950/10 sm:px-8 sm:py-8">
  <div class="pointer-events-none absolute -right-16 -top-28 h-72 w-72 rounded-full border border-white/[0.08]"></div>
  <div class="pointer-events-none absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/[0.08]"></div>
  <div class="relative flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-blue-100"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Official coordination</span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Judges &amp; tabulators</h1>
      <p class="mt-2 max-w-xl text-sm leading-6 text-blue-100/80">Assign active officials to your competitions and keep event responsibilities clear.</p>
    </div>
    <button type="button" onclick="openModal('createModal')" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#d2aa2e] px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/10 transition hover:bg-[#e1bb43]">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/></svg>
      Assign official
    </button>
  </div>
</section>
<section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Official assignment summary">
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-blue-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Assignments</p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{{stats.total}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-700 ring-1 ring-blue-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-700">All officials</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-sky-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Assigned judges</p><p class="mt-3 text-3xl font-bold tracking-tight text-blue-800">{{stats.judges}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-50 text-sky-700 ring-1 ring-sky-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-sky-700">Evaluation team</p>
  </article>
  <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
    <div class="absolute inset-x-0 top-0 h-1 bg-violet-500"></div><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-slate-600">Assigned tabulators</p><p class="mt-3 text-3xl font-bold tracking-tight text-violet-800">{{stats.tabulators}}</p></div><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 text-violet-700 ring-1 ring-violet-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8M8 11h2m4 0h2m-8 4h2m4 0h2"/></svg></span></div><p class="mt-4 border-t border-slate-100 pt-3 text-[10px] font-bold uppercase tracking-[0.14em] text-violet-700">Results team</p>
  </article>
</section>
<section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6"><div><h2 class="text-base font-bold text-slate-950">Official directory</h2><p class="mt-0.5 text-xs text-slate-500 sm:text-sm">Review team members and their event responsibilities.</p></div><span class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-800"><span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>{{stats.shown}} matching</span></div>
  <form method="GET" action="/organizer/assignments" class="grid gap-3 border-b border-slate-100 bg-slate-50/60 p-4 sm:p-5 sm:grid-cols-[minmax(220px,1fr)_220px_auto] sm:items-end">
    <label class="sr-only" for="assignmentEvent">Filter by event</label><select id="assignmentEvent" name="eventId" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"><option value="">All events</option>{{#each events}}<option value="{{id}}" {{#if (eq ../filters.eventId id)}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <label class="sr-only" for="assignmentRole">Filter by role</label><select id="assignmentRole" name="role" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"><option value="">All roles</option><option value="judge" {{#if (eq filters.role 'judge')}}selected{{/if}}>Judge</option><option value="tabulator" {{#if (eq filters.role 'tabulator')}}selected{{/if}}>Tabulator</option></select>
    <div class="flex gap-2"><button class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#102947] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#193e65] sm:flex-none"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16l-6.5 7.5v5L10.5 19v-6.5L4 5Z"/></svg>Filter</button><a href="/organizer/assignments" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 sm:flex-none">Reset</a></div>
  </form>
  <div class="overflow-x-auto">
    <table class="min-w-[850px] w-full text-left text-sm">
      <thead class="bg-slate-50/90 text-[10px] uppercase tracking-[0.14em] text-slate-500"><tr><th class="px-5 py-4 font-bold">Official</th><th class="px-5 py-4 font-bold">Role</th><th class="px-5 py-4 font-bold">Assigned event</th><th class="px-5 py-4 font-bold">Notes</th><th class="px-5 py-4 text-right font-bold">Actions</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        {{#each assignments}}
        <tr class="transition hover:bg-blue-50/40">
          <td class="px-5 py-4"><div class="flex items-center gap-3"><span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-50 to-indigo-100 text-sm font-bold text-blue-700 ring-1 ring-blue-100">{{#if official}}{{official.name.[0]}}{{else}}?{{/if}}</span><div class="min-w-0"><p class="font-semibold text-slate-900">{{#if official}}{{official.name}}{{else}}Account unavailable{{/if}}</p><p class="mt-1 text-xs text-slate-500">{{#if official}}{{official.email}}{{else}}Official account unavailable{{/if}}</p></div></div></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold capitalize {{#if (eq assignmentRole 'judge')}}border-blue-200 bg-blue-50 text-blue-800{{else}}border-violet-200 bg-violet-50 text-violet-800{{/if}}"><span class="h-1.5 w-1.5 rounded-full {{#if (eq assignmentRole 'judge')}}bg-blue-500{{else}}bg-violet-500{{/if}}"></span>{{assignmentRole}}</span></td>
          <td class="px-5 py-4"><span class="inline-flex items-center gap-2 font-medium text-slate-800"><span class="h-2 w-2 rounded-full bg-blue-500"></span>{{#if Event}}{{Event.name}}{{else}}—{{/if}}</span></td>
          <td class="max-w-xs px-5 py-4 text-slate-600">{{#if notes}}<p class="line-clamp-2 text-xs leading-5">{{notes}}</p>{{else}}<span class="text-xs text-slate-400">No notes</span>{{/if}}</td>
          <td class="whitespace-nowrap px-5 py-4 text-right"><div class="inline-flex items-center gap-1"><button type="button" class="rounded-lg px-3 py-2 text-xs font-semibold text-blue-800 transition hover:bg-blue-50" onclick="openEdit('editModal','editForm','{{jsonAttr this}}','/organizer/assignments/{{id}}')">Edit</button><button type="button" class="rounded-lg px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50" onclick="openDelete('deleteModal','deleteForm','/organizer/assignments/{{id}}/delete','{{jsonAttr official.name}}')">Remove</button></div></td>
        </tr>
        {{else}}
        <tr><td class="px-5 py-16 text-center" colspan="5"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m16 0v-2a4 4 0 0 0-3-3.87M14 3.13a4 4 0 0 1 0 7.75M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg></span><p class="mt-4 font-semibold text-slate-800">No officials assigned</p><p class="mt-1 text-sm text-slate-500">Assign active judges and tabulators to coordinate your competition.</p></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
<div id="createModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="createAssignmentTitle"><div class="w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl"><h2 id="createAssignmentTitle" class="text-xl font-semibold text-slate-950">Assign an official</h2><p class="mb-5 mt-1 text-sm text-slate-500">Only active judge and tabulator accounts can be assigned.</p><form method="POST" action="/organizer/assignments">{{> assignment-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('createModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-fair-700">Assign official</button></div></form></div></div>
<div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="editAssignmentTitle"><div class="w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl"><h2 id="editAssignmentTitle" class="text-xl font-semibold text-slate-950">Update official assignment</h2><p class="mb-5 mt-1 text-sm text-slate-500">Assignments with score history are retained to protect the audit trail.</p><form id="editForm" method="POST">{{> assignment-fields}}<div class="mt-5 flex justify-end gap-3 border-t border-slate-100 pt-4"><button type="button" onclick="closeModal('editModal')" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button><button class="rounded-xl bg-fair-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-fair-700">Save changes</button></div></form></div></div>
{{> delete-modal}}
{{> app-end}}
